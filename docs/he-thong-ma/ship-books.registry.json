  {
   "id": "SB-SB.EX01",
   "text": "Bấm \"Thêm mới\" / \"Cập nhật\" khi thiếu trường bắt buộc → Hiển thị lỗi tại trường thiếu, không lưu, không đóng popup.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-SB.EX02",
   "text": "Chưa chọn mẫu tin nhắn → Không cho bấm \"Gửi tin nhắn\" (disable) hoặc báo lỗi bắt buộc chọn.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-SB.EX03",
   "text": "Không có template nào đang bật → Dropdown rỗng, không cho gửi tin nhắn.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-SB.EX04",
   "text": "Gửi tin nhắn thất bại → Báo lỗi, giữ popup, nút xác nhận giữ nguyên trạng thái chưa gửi.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-SB.EX06",
   "text": "Đơn đã gửi tin ở cột nào → Nút ở cột đó không cho bấm gửi lại.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-SB.EX05",
   "text": "Học viên có sẵn bị đổi lại (đổi Tên hoặc Mã học viên sang người khác) → Cặp Tên / Mã học viên luôn khớp nhau, không để lệch dữ liệu.",
   "source": "qc",
   "content": "qc"
  }
 ],
