{
 "cluster": "ship-books",
 "title": "Ship Sách",
 "figmaPrefix": "SB-SB",
 "requirements": [
  {
   "id": "SB-SB.REQ01",
   "name": "Giá trị mặc định",
   "text": "Popup Thêm: Ngày ghi nhận = ngày hôm nay, Trạng thái = Mới.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-SB.REQ02",
   "name": "Đồng bộ Tên - Mã học viên",
   "text": "Khi tick \"Chọn học viên có sẵn\", chọn 1 trong 2 dropdown thì dropdown còn lại tự điền theo (2 chiều).",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-SB.REQ03",
   "name": "Popup xác nhận xoá",
   "text": "Mọi thao tác xoá đơn đều phải qua popup xác nhận trước khi xoá.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-SB.REQ04",
   "name": "Lưu thông tin gửi tin",
   "text": "Lưu thời gian gửi + nội dung tin đã gửi theo từng cột (Xác nhận thông tin / Xác nhận gửi sách) của từng đơn. Hover nút hiển thị lại 2 thông tin này. Mỗi cột chỉ gửi 1 lần, không gửi lại.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-SB.REQ05",
   "name": "Chọn nhiều + Xuất Excel",
   "text": "Nút \"Xuất Excel (n)\" chỉ hiện khi có ít nhất 1 đơn được chọn, n = số đơn đã chọn, vị trí bên phải filter Trạng thái. Checkbox header chọn / bỏ chọn tất cả các đơn đang hiển thị theo bộ lọc hiện tại. File Excel gồm các cột: STT, Tên học viên, Số điện thoại, Địa chỉ, Mã học viên, Loại giáo trình, Ghi chú, Lớp, Trung tâm, Trạng thái, Ngày cập nhật.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-SB.REQ06",
   "name": "Đổi trạng thái tại danh sách",
   "text": "Dropdown Trạng thái ở từng dòng đổi trực tiếp, lưu ngay và cập nhật cột \"Cập nhật\". Hiện chưa có ràng buộc thứ tự giữa các trạng thái, và không liên kết với việc đã gửi tin.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-SB.REQ07",
   "name": "Xoá mềm",
   "text": "Xoá đơn là xoá mềm (đánh dấu xoá, không hiển thị trên danh sách). Chỉ xoá từng đơn, không có xoá hàng loạt.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-SB.REQ08",
   "name": "Trung tâm",
   "text": "Danh sách có bộ lọc `Trung tâm` nằm cùng hàng với các bộ lọc khác, cho chọn một hoặc nhiều trung tâm; khi chọn thì danh sách, tổng số và phân trang chỉ tính dữ liệu của các trung tâm đã chọn, kết hợp `AND` với các bộ lọc khác. Không chọn thì hiển thị dữ liệu của mọi trung tâm. Role Admin không dùng ô chọn trung tâm trên header. Khi tạo mới bắt buộc chọn `Trung tâm`; bản ghi được lưu thuộc trung tâm đã chọn. Backend kiểm tra lại trung tâm khi lưu, không chỉ dựa vào UI.",
   "source": "qc",
   "content": "qc"
  }
 ],
