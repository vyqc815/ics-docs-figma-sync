{
 "cluster": "learning-path-s2",
 "title": "Lộ Trình (S2)",
 "figmaPrefix": "CM-LPS",
 "requirements": [
  {
   "id": "CM-LPS.REQ01",
   "name": "Nguồn dữ liệu cột",
   "text": "Danh sách cột buổi học, số buổi, thời gian mỗi buổi lấy từ S1. Thứ tự cột theo thứ tự ở S1.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-LPS.REQ02",
   "name": "Tính toán realtime",
   "text": "Header cột và cột Thời gian của hàng được tính lại ngay sau mỗi lần tick/bỏ tick, không cần reload.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-LPS.REQ03",
   "name": "Công thức",
   "text": "Tổng phút cột = số ô đã tick × phút/buổi. Thời gian hàng = tổng phút/buổi của các ô đã tick trong hàng đó, hiển thị `HH:mm:ss`.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-LPS.REQ04",
   "name": "Freeze",
   "text": "Cố định 3 cột đầu và hàng đầu khi cuộn ngang/dọc. Khi cuộn ngang, cột buổi học không đè lên 3 cột cố định.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-LPS.REQ05",
   "name": "Màu đỏ",
   "text": "Chỉ áp dụng cho header khi lố buổi (cả số buổi và số phút). Cột Thời gian không có trạng thái đỏ.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-LPS.REQ06",
   "name": "Tự động lưu",
   "text": "Mỗi thao tác tick/bỏ tick, đổi Kỳ, kéo thả gọi API cập nhật ngay, không có nút Lưu. Nếu API lỗi thì hoàn tác thao tác vừa làm và báo lỗi (EX07).",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-LPS.REQ07",
   "name": "Kéo thả bài học",
   "text": "Thứ tự bài học được lưu; thứ tự này chỉ dùng cho màn này, không ảnh hưởng chỗ khác.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-LPS.REQ08",
   "name": "Dropdown Kỳ",
   "text": "Danh sách kỳ lấy từ khoá học hiện tại; mặc định chọn sẵn kỳ của bài học đó.",
   "source": "qc",
   "content": "qc"
  }
 ],
