 "exceptions": [
  {
   "id": "CM-LPS.EX01",
   "text": "Số ô đã tick của 1 cột > tổng số buổi ở S1 → vẫn cho tick, số buổi và số phút ở header hiển thị đỏ (ví dụ 05/04). Không hiện popup chặn.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-LPS.EX02",
   "text": "Bỏ tick làm số buổi về ≤ tổng số buổi → header trở lại màu cam thường.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-LPS.EX03",
   "text": "Hàng bài học chưa tick ô nào → cột Thời gian hiển thị `00:00:00`.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-LPS.EX04",
   "text": "S1 đổi số buổi hoặc thời gian mỗi buổi → các ô đã tick giữ nguyên, header tính lại theo giá trị mới của S1; lố thì đỏ, không lố thì màu thường.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-LPS.EX05",
   "text": "S1 xoá buổi học → xoá toàn bộ tick của cột đó; cột Thời gian của các hàng liên quan tính lại.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-LPS.EX06",
   "text": "S1 thêm buổi học → S2 hiển thị thêm cột mới, chưa có tick (`00/{tổng} [0 PHÚT]`).",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-LPS.EX07",
   "text": "API tự động lưu bị lỗi (mất mạng, server lỗi) → hoàn tác thao tác vừa thực hiện (ô vừa tick/bỏ tick trở về trạng thái cũ, header và cột Thời gian tính lại theo trạng thái cũ) và hiện thông báo lỗi.",
   "source": "qc",
   "content": "qc"
  }
 ],
