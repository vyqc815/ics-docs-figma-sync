 "exceptions": [
  {
   "id": "CM-LM2.EX01",
   "text": "Tên cấp độ, Mô tả cấp độ hoặc Mã cấp độ để trống/chỉ chứa khoảng trắng → không tạo hoặc cập nhật cấp độ; hiển thị lỗi tại field tương ứng.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-LM2.EX02",
   "text": "Mã cấp độ đã tồn tại → không lưu dữ liệu trùng; giữ lại nội dung người dùng đã nhập để chỉnh sửa.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-LM2.EX03",
   "text": "Cấp độ không còn ở trạng thái `Công khai` tại thời điểm feature khác lưu lựa chọn mới → từ chối liên kết mới và yêu cầu tải lại danh sách cấp độ.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-LM2.EX04",
   "text": "Chuyển sang `Công khai` khi dữ liệu bắt buộc không hợp lệ hoặc Mã cấp độ bị trùng → giữ nguyên trạng thái trước khi thao tác.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-LM2.EX05",
   "text": "Người dùng không có quyền nhưng mở URL hoặc gửi request trực tiếp → từ chối thao tác và không thay đổi dữ liệu.",
   "source": "qc",
   "content": "qc"
  }
 ],
