 "title": "Quản lý cấp độ",
 "figmaPrefix": "CM-LM2",
 "requirements": [
  {
   "id": "CM-LM2.REQ01",
   "name": "Quản lý danh sách cấp độ",
   "text": "Cho phép `Curriculum Development Handler` xem toàn bộ danh sách và thêm cấp độ mới. Tên, Mô tả và Mã cấp độ là bắt buộc; cấp độ mới mặc định ở trạng thái `Nháp`.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-LM2.REQ02",
   "name": "Quản lý trạng thái",
   "text": "Cấp độ có ba trạng thái `Nháp`, `Công khai`, `Vô hiệu hóa` và được chuyển tự do giữa mọi trạng thái. Chỉ cấp độ `Công khai` được dùng cho lựa chọn mới; thay đổi trạng thái không tự động xóa liên kết đã tồn tại.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-LM2.REQ03",
   "name": "Cung cấp dữ liệu cấp độ",
   "text": "`Mã cấp độ` là mã tham chiếu dùng khi chọn cấp độ cho khóa học tại feature `Quản lý danh mục`. Danh sách lựa chọn phải lấy từ dữ liệu cấp độ đã định nghĩa và chỉ gồm các bản ghi `Công khai`.",
   "source": "qc",
   "content": "qc"
  }
 ],
