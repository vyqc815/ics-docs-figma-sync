{
 "cluster": "statistics",
 "title": "[Phụ trách lớp] Thống kê",
 "figmaPrefix": "CHS-ST",
 "requirements": [
  {
   "id": "CHS-ST.REQ01",
   "name": "Phạm vi",
   "text": "Chỉ lớp có user trong danh sách Phụ trách lớp (loại Hủy, Xóa) và hoá đơn/khoản KPI của chính user; backend xác định user từ token.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CHS-ST.REQ02",
   "name": "Bộ lọc",
   "text": "Trung tâm (chọn nhiều, mặc định tất cả), Thời gian (chọn 1, mặc định Tháng này), Trình độ, Học kỳ (chọn nhiều, mặc định tất cả). Mọi thẻ theo bộ lọc; KPI Cá Nhân theo Trung tâm + Thời gian.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CHS-ST.REQ03",
   "name": "Thẻ KPI",
   "text": "KPI Cá Nhân = Số KPI của Trang chủ; Tiền KPI Lớp = KPI Đã xác nhận của user, ngày ghi nhận trong khoảng.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CHS-ST.REQ04",
   "name": "Thẻ Lớp",
   "text": "Số Lớp Bắt Đầu / Kết Thúc theo ngày bắt đầu / kết thúc chính thức trong khoảng; Tổng Số Lớp = lớp đang phụ trách trong khoảng.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CHS-ST.REQ05",
   "name": "Thẻ Tỉ lệ",
   "text": "Đi Học, BTVN, Lên Kỳ theo công thức Trang chủ, tính trên Tập lớp trong khoảng; Đi Học/BTVN chỉ lấy buổi/bài trong khoảng.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CHS-ST.REQ06",
   "name": "Thẻ Doanh thu",
   "text": "Tổng Doanh Thu Lớp = học phí đã đóng của Tập lớp trong khoảng; Doanh Thu Trung Bình = Tổng Doanh Thu Lớp / Tổng Số Lớp.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CHS-ST.REQ07",
   "name": "Dòng khoảng ngày",
   "text": "Mỗi nhóm thẻ hiển thị `(Trong khoảng: dd.MM.yyyy - dd.MM.yyyy)` theo bộ lọc Thời gian.",
   "source": "qc",
   "content": "qc"
  }
 ],
