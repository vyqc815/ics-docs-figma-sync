 "figmaPrefix": "CM-TE",
 "requirements": [
  {
   "id": "CM-TE.REQ01",
   "name": "Danh sách",
   "text": "Bài kiểm tra của học kỳ đang chọn theo thứ tự đã sắp; card có ID 10 số, tên, chip thời gian, chip số câu, nút `>`.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-TE.REQ02",
   "name": "Thêm bài",
   "text": "Chỉ khi học kỳ `Nháp`; nhập tên ở ô cuối danh sách; ID 10 số hệ thống tự sinh, duy nhất; bài mới ở cuối.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-TE.REQ03",
   "name": "Sắp xếp",
   "text": "Kéo thả khi học kỳ `Nháp`; thứ tự dùng ở menu Bài Tập Về Nhà và lớp học.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-TE.REQ04",
   "name": "Quyền sửa theo trạng thái học kỳ / khoá học",
   "text": "Danh sách bài (thêm, sắp xếp, xoá), tab Thông tin và bộ câu hỏi chỉ sửa khi học kỳ `Nháp` **và** khoá học `Nháp`; học kỳ hoặc khoá học `Công khai` / `Vô hiệu` chỉ đọc toàn bộ (xem `course_management.md` REQ10). Nhân bản học kỳ / khoá học sao chép toàn bộ bài kiểm tra và bộ câu hỏi.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-TE.REQ05",
   "name": "Xoá bài",
   "text": "Xoá mềm bài và bộ câu hỏi, qua popup xác nhận, chỉ khi học kỳ `Nháp` và khoá học `Nháp`.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-TE.REQ06",
   "name": "Thông tin bài",
   "text": "Tiêu đề, Độ khó (1 - Dễ / Bình thường / Khó), Thời gian làm bài (giờ : phút : giây, > 0) bắt buộc; Mô tả, Điểm đạt (0 ≤ Điểm đạt ≤ 10, thang 10) không bắt buộc; Số câu hỏi tự tính, chỉ đọc; không có Tổng điểm; lưu tự động từng field.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-TE.REQ07",
   "name": "Bộ câu hỏi",
   "text": "Soạn trong tab Bộ Câu Hỏi của popup, cùng quy tắc `homework-test.md`; dùng chung dữ liệu với menu Bài Tập Về Nhà → tab Kiểm tra.",
   "source": "qc",
   "content": "qc"
  }
 ],
