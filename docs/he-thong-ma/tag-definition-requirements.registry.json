{
 "cluster": "tag-definition-requirements",
 "title": "Define Tag — Quản lý nhóm và tag",
 "figmaPrefix": "TD-TD",
 "requirements": [
  {
   "id": "TD-TD.REQ01",
   "name": "Hiển thị",
   "text": "Define Tag hiển thị nhóm và tag cùng tên, mô tả, Loại đã lưu; chọn nhóm chỉ xem tag thuộc nhóm đó.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "TD-TD.REQ02",
   "name": "Loại nhóm",
   "text": "Popup Thêm nhóm có Tên nhóm, Mô tả, Loại; Loại chỉ gồm Học viên/Giáo viên/Lớp/Hoá đơn/Ghi chú và được lưu ở cấp nhóm.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "TD-TD.REQ03",
   "name": "Nhóm và Loại của tag",
   "text": "Tag bắt buộc thuộc một nhóm; phải có nhóm rồi mới thêm được tag. Form thêm tag không có trường Loại và tag kế thừa Loại của nhóm; không cho lưu tag khác loại với nhóm.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "TD-TD.REQ04",
   "name": "Phản hồi",
   "text": "Thêm/sửa/xóa chỉ báo thành công sau khi xử lý xong; Hủy hoặc lỗi xử lý không làm thay đổi dữ liệu.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "TD-TD.REQ05",
   "name": "Nhập liệu",
   "text": "Khi thêm tag, Tên tag và Màu sắc là bắt buộc; Mô tả không bắt buộc. Không kiểm tra trùng tên và không có giới hạn nghiệp vụ khác cho Tên nhóm, Tên tag, Mô tả, Màu sắc. Tag không có field Ngày thống kê và Riêng tư. Không áp đặt mặc định từ dữ liệu mẫu UI.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "TD-TD.REQ06",
   "name": "CRUD",
   "text": "Admin, Class Handler và Support được xem, thêm, sửa, xóa nhóm và tag. Sửa tag được đổi nhóm của tag. Xóa nhóm không xóa các tag thuộc nhóm.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "TD-TD.REQ07",
   "name": "ComGao",
   "text": "Tag ICS dùng chung bảng và bản ghi với ComGao; thao tác không tạo bản sao riêng. Nhóm/tag dùng chung cho toàn hệ thống, không phân theo center.",
   "source": "qc",
   "content": "qc"
  }
 ],
