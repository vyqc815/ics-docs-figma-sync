 "exceptions": [
  {
   "id": "SB-0TS.EX01",
   "text": "Khảo sát bị thu hồi / xoá khi GV đang làm → Lưu nháp / Gửi trả lỗi → popup \"Khảo sát đã bị thu hồi\" → về Khảo sát của tôi.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-0TS.EX02",
   "text": "Rời trang (back, đổi menu) khi còn thay đổi chưa lưu → popup xác nhận (Lưu nháp & rời / Rời không lưu / Ở lại). Đóng tab / F5 → cảnh báo mặc định của trình duyệt.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-0TS.EX03",
   "text": "Truy cập URL khảo sát không được giao / đã thu hồi → báo \"Không tìm thấy khảo sát\" → về danh sách. Đã hoàn thành → chuyển sang chế độ xem lại.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-0TS.EX04",
   "text": "Gửi / Lưu nháp lỗi mạng → giữ nguyên câu trả lời trên màn hình, toast lỗi, cho thao tác lại.",
   "source": "qc",
   "content": "qc"
  }
 ],
