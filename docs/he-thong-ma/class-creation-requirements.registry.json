 "exceptions": [
  {
   "id": "M-CC.EX01",
   "text": "Người dùng không có role `Admin` hoặc `Class Handler` gửi request tạo lớp trực tiếp → backend từ chối và không tạo dữ liệu.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CC.EX02",
   "text": "Danh sách Khóa học tải lỗi hoặc khóa học thiếu cấu hình Số buổi → không cho tạo lớp; hiển thị lỗi và cho phép thử lại.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CC.EX03",
   "text": "Lịch dạy có giờ không hợp lệ, không bao gồm Ngày bắt đầu hoặc bị trùng → không đưa lịch lỗi về popup chính và không tạo lớp.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CC.EX04",
   "text": "Request tạo lớp thất bại hoặc bị gửi lặp → không tạo lớp một phần hoặc nhiều lớp trùng nhau; hiển thị đúng một notification kết quả.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CC.EX05",
   "text": "Request chuyển trạng thái lớp/học viên không thỏa điều kiện → backend từ chối, giữ nguyên trạng thái và trả đúng điều kiện còn thiếu.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CC.EX06",
   "text": "Người không có role `Admin` hoặc `Class Handler` gửi request tạo lớp với Loại lớp `Lớp demo`, hoặc client cố giả lập lớp test → backend từ chối; không tạo lớp test hoặc dữ liệu một phần.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CC.EX07",
   "text": "Thiếu `Trung tâm`, `Khóa học`, `Loại lớp`, `Phụ trách chính`, `CSKH chính` hoặc `Mô tả` → không tạo lớp và trả lỗi đúng field thiếu.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CC.EX08",
   "text": "Request gán `Phụ trách chính` không có role `Class Handler`, hoặc `CSKH chính` không có role `Support` → backend từ chối và không tạo lớp.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CC.EX09",
   "text": "Request gửi loại lớp ngoài `Lớp chung`/`Lớp 1-1`/`Lớp demo`, gửi Link Google Meet không phải URL HTTP(S), hoặc cố ghi đè Ngày kết thúc → backend từ chối dữ liệu không hợp lệ và không tạo lớp.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CC.EX10",
   "text": "Khóa học hoặc người dùng được chọn đã ngừng hoạt động, không còn tồn tại hoặc nằm ngoài phạm vi của người tạo tại thời điểm xác nhận → backend từ chối toàn bộ request, không tạo lớp một phần và yêu cầu chọn lại dữ liệu hợp lệ.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CC.EX11",
   "text": "Mã lớp tự sinh trùng với một lớp đã tồn tại (kể cả lớp đã xóa) → backend sinh mã khác, không tạo lớp trùng mã và không báo lỗi cho người dùng vì mã trùng.",
   "source": "qc",
   "content": "qc"
  }
 ],
