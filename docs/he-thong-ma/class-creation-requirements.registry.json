{
 "cluster": "class-creation-requirements",
 "title": "Tạo lớp học",
 "figmaPrefix": "M-CC",
 "requirements": [
  {
   "id": "M-CC.REQ01",
   "name": "Dữ liệu tạo lớp",
   "text": "Popup hiển thị các field và popup con đã mô tả. `Trung tâm`, `Khóa học`, `Loại lớp`, `Phụ trách chính`, `CSKH chính` và `Mô tả` là bắt buộc. Mã lớp do hệ thống tự động sinh, duy nhất toàn hệ thống; người dùng không nhập và backend không nhận Mã lớp từ client. Backend kiểm tra lại dữ liệu, không tin cậy trạng thái, Số buổi hoặc người phụ trách do client tự gán.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CC.REQ02",
   "name": "Khóa học và Số buổi",
   "text": "Khóa học chỉ lấy từ dữ liệu define. Số buổi của khóa học bằng tổng số buổi học của các học kỳ đang `Công khai` thuộc khóa học đó; học kỳ `Nháp` không được tính. Số buổi của lớp bằng Số buổi của khóa học; người dùng không tự nhập giá trị khác.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CC.REQ03",
   "name": "Lịch dạy cố định",
   "text": "Ngày bắt đầu là buổi 1. Hệ thống sinh các buổi tiếp theo theo lịch cố định, đủ đúng Số buổi của khóa học rồi dừng.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CC.REQ04",
   "name": "Trạng thái ban đầu",
   "text": "Không có lịch dạy tạo trạng thái `Mới tạo`; có lịch dạy hợp lệ tạo trạng thái `Khai giảng`. Thêm lịch hợp lệ cho lớp `Mới tạo` tự chuyển lớp sang `Khai giảng`.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CC.REQ05",
   "name": "Điều kiện Đang học",
   "text": "Chỉ `Class Handler` được đổi trạng thái lớp. Chuyển sang `Đang học` cần Meet, Tiêu chuẩn GV, Quy trình lớp, ít nhất 1 học viên ở trạng thái `Đang học` và toàn bộ nhóm học viên đó đáp ứng điều kiện học phí. Học viên chỉ được chuyển sang `Đang học` khi hồ sơ đáp ứng requirement học phí riêng.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CC.REQ06",
   "name": "Notification",
   "text": "Tạo lớp, thêm lịch và chuyển trạng thái thành công/thất bại phải hiển thị đúng một notification sau kết quả backend. Hủy popup không hiển thị notification CUD.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CC.REQ07",
   "name": "Lớp không chính thức",
   "text": "Lớp không chính thức là lớp có Loại lớp `Lớp demo`; `Admin` và `Class Handler` đều được chọn loại này để tạo lớp test. Lớp test mở toàn bộ bài học/bài kiểm tra và bỏ qua điều kiện nghiệp vụ khi đổi trạng thái. Role khác không được tạo lớp demo. Lớp demo không được đổi sang loại lớp chính thức.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CC.REQ08",
   "name": "Phân quyền tạo lớp",
   "text": "Chỉ `Admin` và `Class Handler` được tạo lớp. Backend phải từ chối request tạo lớp của mọi role khác.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CC.REQ09",
   "name": "Role phụ trách",
   "text": "`Phụ trách chính` bắt buộc là người dùng có role `Class Handler`; `CSKH chính` bắt buộc là người dùng có role `Support`.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CC.REQ10",
   "name": "Ngày kết thúc",
   "text": "Field chỉ đọc, tự lấy ngày của buổi cuối sau khi sinh đủ số buổi. Không có lịch thì để trống; không nhận giá trị do client tự gửi.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CC.REQ11",
   "name": "Loại lớp",
   "text": "Chỉ chấp nhận `Lớp chung`, `Lớp 1-1` và `Lớp demo` (lớp không chính thức). Đây là giá trị phân loại được lưu độc lập với sĩ số; `Lớp 1-1` có thể có nhiều học viên.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CC.REQ12",
   "name": "Trung tâm",
   "text": "Khi tạo mới bắt buộc chọn `Trung tâm`; bản ghi được lưu thuộc trung tâm đã chọn. Backend kiểm tra lại trung tâm khi lưu, không chỉ dựa vào UI. Danh sách Khóa học trong popup lấy theo trung tâm đã chọn.",
   "source": "qc",
   "content": "qc"
  }
 ],
