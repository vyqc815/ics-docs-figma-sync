 "exceptions": [
  {
   "id": "M-CDT.EX01",
   "text": "Role ngoài `Admin`, `Class Handler`, `Support` hoặc người dùng ngoài phạm vi gửi request CRUD → backend từ chối và không thay đổi dữ liệu.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDT.EX02",
   "text": "Cùng giáo viên được thêm lặp/đồng thời → chỉ tồn tại một quan hệ hoạt động trong lớp.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDT.EX03",
   "text": "Giáo viên đã thuộc lớp, `Nghỉ việc`, tài khoản/hồ sơ không còn hiệu lực hoặc ngoài phạm vi → không hiển thị như lựa chọn hợp lệ và không được thêm. Nếu trạng thái thay đổi sau khi popup tải, backend từ chối toàn bộ multi-select để không tạo dữ liệu một phần.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDT.EX04",
   "text": "Dữ liệu tạo giáo viên sai/trùng, trạng thái không thuộc `Training`/`Chính thức`/`Thử việc` hoặc client gửi `Nghỉ việc`/`Testing` → từ chối tạo.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDT.EX05",
   "text": "Tạo hồ sơ thành công nhưng liên kết lớp thất bại → không hiển thị quan hệ giả, không tạo lại tài khoản trùng và trả hướng xử lý rõ ràng.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDT.EX06",
   "text": "Hai request cùng gán Phụ trách chính → backend/database bảo đảm tối đa một người chính và trả dữ liệu mới nhất cho request xung đột.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDT.EX07",
   "text": "Giáo viên bị xóa/chuyển quan hệ trong lúc popup đang mở → không xóa nhầm tài khoản/giáo viên khác hoặc làm mất người chính mới.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDT.EX08",
   "text": "Giáo viên không phải Phụ trách chính hoặc role quản lý gửi request nhập/cập nhật điểm BTVN hay bài kiểm tra → backend từ chối và không ghi dữ liệu điểm.",
   "source": "qc",
   "content": "qc"
  }
 ],
