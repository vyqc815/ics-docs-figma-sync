{
 "cluster": "class-detail-teachers-requirements",
 "title": "Chi tiết lớp học — Tab Giáo viên",
 "figmaPrefix": "M-CDT",
 "requirements": [
  {
   "id": "M-CDT.REQ01",
   "name": "Danh sách giáo viên lớp",
   "text": "Hiển thị Tên, Mã, Email, Phụ trách chính và Xóa từ quan hệ giáo viên–lớp; cho phép 0, 1 hoặc nhiều giáo viên nhưng không trùng.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDT.REQ02",
   "name": "Điểm vào thêm",
   "text": "`Thêm giáo viên vào lớp` mở đúng hai flow `Chọn giáo viên` và `Tạo giáo viên mới`; chỉ Admin/Class Handler/Support được thao tác.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDT.REQ03",
   "name": "Chọn giáo viên hiện có",
   "text": "Tìm theo tên/mã và hỗ trợ multi-select. Danh sách chỉ trả giáo viên `Training`, `Chính thức`, `Thử việc` còn hiệu lực và chưa thuộc lớp. Không có trạng thái Testing. Giáo viên `Nghỉ việc` không xuất hiện ngay cả khi tìm đúng tên/mã; backend từ chối teacher_id Nghỉ việc gửi trực tiếp.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDT.REQ04",
   "name": "Tạo giáo viên",
   "text": "Dùng chung popup/rule module Giáo viên, bổ sung Trạng thái và Ghi chú; Code do backend sinh; role cố định Teacher; tạo xong tự gắn lớp, không tự làm Phụ trách chính.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDT.REQ05",
   "name": "Duy nhất Phụ trách chính",
   "text": "Mỗi lớp có tối đa một Giáo viên phụ trách chính. Giáo viên đầu tiên không tự thành người chính; phải được tick thủ công. Chuyển người chính phải bỏ người cũ và gán người mới trong một giao dịch. Cho phép lớp tạm thời không có người chính.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDT.REQ06",
   "name": "Quyền chấm điểm",
   "text": "Chỉ tài khoản Teacher đang là Phụ trách chính hiện tại của lớp được nhập/cập nhật điểm BTVN và bài kiểm tra. Role quản lý không được chấm thay. Giáo viên không được xem tab quản lý này. Điểm và audit cũ không đổi khi chuyển người chính.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDT.REQ07",
   "name": "Xóa khỏi lớp",
   "text": "Xóa mềm quan hệ, không xóa tài khoản, điểm, lương, lịch sử hoặc dữ liệu buổi đã hoàn thành. Cho phép xóa người chính không cần người thay thế; lớp không có quyền chấm BTVN/bài kiểm tra cho đến khi gán mới.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDT.REQ08",
   "name": "Điều hướng",
   "text": "Bấm giáo viên mở đúng Chi tiết theo teacher_id và quyền module Giáo viên; checkbox/Xóa không kích hoạt điều hướng.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDT.REQ09",
   "name": "Audit và an toàn",
   "text": "Lưu người/thời điểm cho thêm, tạo, đổi phụ trách, xóa; không tin role/trạng thái/ID do client tự khai; không lộ mật khẩu hoặc lỗi kỹ thuật.",
   "source": "qc",
   "content": "qc"
  }
 ],
