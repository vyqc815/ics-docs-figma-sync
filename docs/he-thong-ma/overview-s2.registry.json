 "exceptions": [
  {
   "id": "CM-OS2.EX01",
   "text": "Tổng thời gian các nội dung trong bảng vượt quá \"Tổng thời gian\" ở card tổng quan (khiến \"Thời gian còn lại\" âm) → card \"Thời gian còn lại\" hiển thị giá trị âm màu **đỏ** để cảnh báo CD (không chặn thao tác).",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-OS2.EX02",
   "text": "Nhập Số buổi (card hoặc dòng) là số âm, số thập phân hoặc chữ → không lưu, giữ giá trị cũ; xoá trống ô Số buổi → giá trị về `0`. Nhập Thời gian mỗi buổi không phải số nguyên dương (0, số âm, số thập phân, chữ, để trống) → không lưu, giữ giá trị cũ.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-OS2.EX03",
   "text": "Tên nội dung để trống hoặc chỉ khoảng trắng: khi thêm mới thì không tạo; khi sửa thì không lưu, trả về tên cũ.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-OS2.EX05",
   "text": "Giảm Số buổi, đổi Loại hoặc xoá dòng làm số cụm của loại phải giảm, nhưng cụm sẽ bị bỏ còn mục hoặc còn liên kết bài học → BE từ chối, giữ giá trị cũ, Toast `Cảnh Báo` `Cụm <tên> của <loại> còn dữ liệu, dọn cụm ở S1 / S6 trước.`",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-OS2.EX06",
   "text": "Chọn Loại `Bảng chữ` ở trung tâm không có hệ chữ riêng (qua request) → BE từ chối.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-OS2.EX04",
   "text": "Thời gian học nhập phút hoặc giây vượt 59 (ví dụ `00:00:120`, `1:70:00`) → hệ thống tự quy đổi phần vượt lên đơn vị lớn hơn cho đúng (`00:02:00`, `02:10:00`), rồi lưu và tính lại.",
   "source": "qc",
   "content": "qc"
  }
 ],
