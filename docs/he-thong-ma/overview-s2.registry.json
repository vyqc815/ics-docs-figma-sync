{
 "cluster": "overview-s2",
 "title": "Tổng quan (S2)",
 "figmaPrefix": "CM-OS2",
 "requirements": [
  {
   "id": "CM-OS2.REQ01",
   "name": "Công thức Tổng thời gian (dòng)",
   "text": "Tổng thời gian (dòng) = Số buổi (dòng) × Thời gian học (dòng).",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-OS2.REQ02",
   "name": "Công thức % (dòng)",
   "text": "% (dòng) = Tổng thời gian (dòng) ÷ Tổng thời gian (card tổng quan) × 100, làm tròn 2 chữ số thập phân. Tổng thời gian (card) = 0 thì % = 0%.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-OS2.REQ03",
   "name": "Công thức Tổng thời gian (card)",
   "text": "Tổng thời gian (card tổng quan) = Số buổi (card) × Thời gian mỗi buổi (card).",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-OS2.REQ04",
   "name": "Công thức Thời gian thực tế (card)",
   "text": "Thời gian thực tế (card) = tổng cột \"Tổng thời gian\" của toàn bộ các dòng trong bảng.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-OS2.REQ05",
   "name": "Công thức Thời gian còn lại (card)",
   "text": "Thời gian còn lại (card) = Tổng thời gian (card) − Thời gian thực tế (card).",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-OS2.REQ06",
   "name": "Nhập Số buổi / Thời gian mỗi buổi (card)",
   "text": "Do CD tự nhập tay, không tự động lấy từ nguồn dữ liệu khác, không giới hạn tối đa. Số buổi: số nguyên ≥ 0, mặc định 0, xoá trống thì về 0. Thời gian mỗi buổi: số nguyên dương, đơn vị phút, mặc định 90.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-OS2.REQ07",
   "name": "Thêm nhanh bằng Tên + Enter",
   "text": "Chỉ cần nhập Tên và nhấn Enter là tạo được nội dung mới; các field khác để trống/mặc định, bổ sung sau. Tên bắt buộc, khi sửa để trống thì trả về tên cũ.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-OS2.REQ08",
   "name": "Loại thao tác của nội dung",
   "text": "Mỗi nội dung có loại thao tác là Tự chọn hoặc Giảng dạy, đổi qua lại bằng icon cạnh nút xoá trong cột \"Thao tác\". Nội dung mới tạo mặc định là Giảng dạy.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-OS2.REQ09",
   "name": "Màu Thời gian còn lại",
   "text": "Âm: màu đỏ (cảnh báo, không chặn thao tác); dương: màu xanh lá; bằng 0: màu đen mặc định.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-OS2.REQ10",
   "name": "Xoá mềm nội dung",
   "text": "Xoá một nội dung buổi học là xoá mềm, có popup xác nhận trước khi xoá.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-OS2.REQ12",
   "name": "Loại và số cụm",
   "text": "Mỗi dòng nội dung có đúng 1 Loại kiến thức / kỹ năng. Với từng loại: số cụm ở S1 / S6 = tổng Số buổi các dòng cùng loại; hệ thống tự tạo cụm rỗng `Chủ đề k` khi tăng, tự xoá cụm rỗng chưa liên kết khi giảm, chặn khi cụm bị bỏ còn mục hoặc còn liên kết bài học. CD không nhập Số cụm ở S1 / S6. Dòng chưa chọn Loại không tính vào số cụm.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-OS2.REQ11",
   "name": "Định dạng Thời gian học",
   "text": "Thời gian học lưu và hiển thị theo `HH:mm:ss`. Giá trị nhập có phút hoặc giây vượt 59 được tự quy đổi lên đơn vị lớn hơn (ví dụ `00:00:120` → `00:02:00`).",
   "source": "qc",
   "content": "qc"
  }
 ],
