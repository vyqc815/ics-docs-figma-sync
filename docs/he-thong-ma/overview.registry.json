{
 "cluster": "overview",
 "title": "[Phụ trách lớp] Trang chủ — Thống kê tổng quan",
 "figmaPrefix": "CHS-OV",
 "requirements": [
  {
   "id": "CHS-OV.REQ01",
   "name": "Phạm vi dữ liệu",
   "text": "Không dùng trung tâm ở header. Chỉ lớp có user trong danh sách Phụ trách lớp và hoá đơn có user là Người phụ trách. Backend xác định user từ token, không nhận `handler_id` từ client.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CHS-OV.REQ02",
   "name": "Bộ lọc đồng bộ",
   "text": "Trung tâm (mặc định Tất cả), Loại lớp, Khoá học, Trạng thái (`Đang học`, `Hoàn thành`; mặc định Đang học), Thời gian (mặc định Tháng này), Chế độ lọc (4 mốc ngày, chọn nhiều; mặc định Ngày kết thúc chính thức; bỏ chọn hết thì Thời gian không lọc tập lớp). Mọi bộ lọc áp cho tập lớp; thẻ hoá đơn áp Trung tâm + Thời gian.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CHS-OV.REQ03",
   "name": "Thẻ hoá đơn & KPI",
   "text": "Doanh Thu = Σ Giá trị HĐ × KPI PTL / Tổng KPI HĐ; Số KPI = Σ KPI PTL; KPI Nhận Được = Σ KPI PTL / Σ Tổng KPI HĐ; KPI Lớp = tiền KPI Đã xác nhận của user thuộc các lớp trong tập.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CHS-OV.REQ04",
   "name": "Thẻ học tập",
   "text": "Số Lớp; Đi Học, BTVN theo công thức trang Lớp role Giáo viên (trung bình theo học viên); Lên Kỳ = trung bình tỷ lệ lên kỳ từng lớp (lớp Hoàn thành: Up-sale/Force/Super up-sale/Hoàn thành ÷ học viên còn tính; lớp chưa hoàn thành: Đang học ÷ (tổng − chuyển lớp)); 1 chữ số thập phân; badge hạng tổng getEvaluate.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CHS-OV.REQ08",
   "name": "Tỷ lệ lên kỳ lớp",
   "text": "Vòng `%` trên card và thẻ Lên Kỳ dùng cùng tỷ lệ lên kỳ của lớp; mẫu số 0 → 0%.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CHS-OV.REQ05",
   "name": "Khối lớp đang chọn",
   "text": "Bấm card hiện thông số nhanh; mặc định lớp đầu tiên; Kết quả, ngày (kết thúc viền đỏ khi chưa đến hạn), khung giờ, 6 chỉ số + biểu đồ theo Tổng quan lớp.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CHS-OV.REQ06",
   "name": "Danh sách lớp",
   "text": "Card: icon trạng thái, mã lớp, khoá học, tiến độ `x/y Buổi`, badge hạng, vòng KPI lớp, `>` vào Quản lý → Lớp học → Tổng quan lớp. Sắp theo mã lớp, không phân trang.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CHS-OV.REQ07",
   "name": "Chỉ xem",
   "text": "Trang không có thao tác thêm/sửa/xoá; không có Toast CRUD.",
   "source": "qc",
   "content": "qc"
  }
 ],
