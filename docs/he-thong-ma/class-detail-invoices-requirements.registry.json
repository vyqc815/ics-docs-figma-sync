 "exceptions": [
  {
   "id": "M-CDI2.EX01",
   "text": "Chưa có hóa đơn dùng trong lớp → hiển thị empty state.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDI2.EX02",
   "text": "API lỗi/hết thời gian chờ → hiển thị lỗi và Thử lại; không biến lỗi thành số 0.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDI2.EX03",
   "text": "Response lớp cũ về muộn → bỏ response không còn phù hợp class_id hiện tại.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDI2.EX04",
   "text": "Người dùng không có quyền xem tài chính hoặc ngoài phạm vi lớp → từ chối truy cập; không trả tên hóa đơn và tiền.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDI2.EX05",
   "text": "Dữ liệu hóa đơn thiếu hoặc không nhất quán → báo trạng thái dữ liệu không khả dụng; không tự suy ra giá trị hóa đơn từ tổng học phí.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDI2.EX06",
   "text": "Tải thêm thất bại → giữ các dòng hiện có và cursor chưa thành công; hiển thị Thử lại ở cuối bảng.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDI2.EX07",
   "text": "Response bộ lọc cũ trả về sau khi đổi điều kiện → bỏ response, không nối hoặc ghi đè kết quả bộ lọc hiện tại.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDI2.EX08",
   "text": "Lớp có hóa đơn nhưng không khớp bộ lọc → hiển thị empty state theo bộ lọc; không báo lớp chưa có hóa đơn.",
   "source": "qc",
   "content": "qc"
  }
 ],
