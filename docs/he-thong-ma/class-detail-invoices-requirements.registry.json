{
 "cluster": "class-detail-invoices-requirements",
 "title": "Chi tiết lớp học — Tab Hóa đơn",
 "figmaPrefix": "M-CDI2",
 "requirements": [
  {
   "id": "M-CDI2.REQ01",
   "name": "Chỉ xem",
   "text": "Tab hiển thị thông tin hóa đơn và học phí; không CRUD và không mở popup chỉnh sửa từ dòng.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDI2.REQ02",
   "name": "Danh sách",
   "text": "Chỉ hóa đơn đã dùng cho lớp hiện tại; một dòng mỗi invoice_id, không gộp theo tên.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDI2.REQ03",
   "name": "Giá trị tiền",
   "text": "Giá trị là tổng giá trị hóa đơn. Giá trị dùng trong lớp là tổng học phí ghi nhận từ hóa đơn cho lớp hiện tại; không phải số dư hoặc tổng dùng ở mọi lớp.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDI2.REQ04",
   "name": "Hiển thị",
   "text": "Tên dài xuống dòng, tiền VND căn phải với dấu phân cách hàng nghìn; layout đọc được trên các kích thước màn hình.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDI2.REQ05",
   "name": "Đồng bộ",
   "text": "Mở/tải lại tab hiển thị dữ liệu mới nhất đã lưu; không nhân đôi giao dịch hoặc dùng dữ liệu ngoài class_id.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDI2.REQ06",
   "name": "Quyền và bảo mật",
   "text": "Chỉ Admin/Class Handler/Support được xem trong phạm vi lớp; Teacher và mọi role khác bị chặn tại UI và API. Nội dung tên hóa đơn hiển thị an toàn, không thực thi HTML/script.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDI2.REQ07",
   "name": "Load-more",
   "text": "Cuộn gần cuối tự tải nhóm hóa đơn tiếp theo; không phân trang số. Giữ vị trí cuộn, chống request/dòng trùng, hỗ trợ thử lại và dừng khi hết dữ liệu.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDI2.REQ08",
   "name": "Học viên",
   "text": "Bổ sung cột Tên học viên và filter Học viên chọn một hoặc nhiều người theo quan hệ student_id với hóa đơn đã dùng trong lớp. Nhiều người áp dụng OR giữa các student_id; không chọn thì không giới hạn theo học viên. Lọc toàn bộ dữ liệu trước load-more; đổi/bỏ lựa chọn phải reset kết quả và cursor, tải thêm/retry theo đúng tập đã chọn. Không suy ra học viên từ tên hóa đơn và không bỏ dữ liệu lịch sử do trạng thái Rời lớp / Nghỉ học / Xóa mềm.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDI2.REQ09",
   "name": "Ngày tạo hóa đơn",
   "text": "Bổ sung cột chỉ xem ngày tạo gốc Cơm Gạo đồng bộ sang ICS, không dùng ngày đồng bộ, ngày học phí hoặc ngày sửa. **Không có filter ngày tạo hóa đơn**, không gửi điều kiện ngày trong request lọc. Thiếu ngày tạo thì đánh dấu cột không khả dụng, không tự thay ngày hoặc loại hóa đơn khỏi bảng.",
   "source": "qc",
   "content": "qc"
  }
 ],
