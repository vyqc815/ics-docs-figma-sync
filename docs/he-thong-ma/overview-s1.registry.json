   "id": "CM-OS.REQ01",
   "name": "Công thức Tổng thời gian (dòng)",
   "text": "Tổng thời gian (dòng) = Số buổi (dòng) × Thời gian học (dòng).",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-OS.REQ02",
   "name": "Công thức % (dòng)",
   "text": "% (dòng) = Tổng thời gian (dòng) ÷ Tổng thời gian (card tổng quan) × 100.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-OS.REQ03",
   "name": "Công thức Tổng thời gian (card)",
   "text": "Tổng thời gian (card tổng quan) = Số buổi (card) × Thời gian mỗi buổi (card).",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-OS.REQ04",
   "name": "Công thức Thời gian thực tế (card)",
   "text": "Thời gian thực tế (card) = tổng cột \"Tổng thời gian\" của toàn bộ các dòng trong bảng.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-OS.REQ05",
   "name": "Công thức Thời gian còn lại (card)",
   "text": "Thời gian còn lại (card) = Tổng thời gian (card) − Thời gian thực tế (card).",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-OS.REQ06",
   "name": "Nhập Số buổi / Thời gian mỗi buổi (card)",
   "text": "2 giá trị này mặc định là 0, do CD tự nhập tay, không tự động lấy từ nguồn dữ liệu khác.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-OS.REQ07",
   "name": "Thêm nhanh bằng Tên + Enter",
   "text": "Chỉ cần nhập Tên và nhấn Enter là tạo được nội dung mới; các field khác để trống/mặc định, bổ sung sau.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-OS.REQ08",
   "name": "Loại thao tác của nội dung",
   "text": "Mỗi nội dung có loại thao tác là Tự chọn hoặc Giảng dạy, đổi qua lại bằng icon cạnh nút xoá trong cột \"Thao tác\".",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-OS.REQ09",
   "name": "Cảnh báo khi Thời gian còn lại âm",
   "text": "Khi tổng thời gian các nội dung vượt quá Tổng thời gian (card), hệ thống hiển thị cảnh báo cho CD.",
   "source": "qc",
   "content": "qc"
  },
