 "exceptions": [
  {
   "id": "SB-0AS.EX01",
   "text": "Xoá dòng đã có bài Đã hoàn thành, hoặc xoá khảo sát khỏi trang Giao khi đã có kết quả → popup cảnh báo \"Kết quả khảo sát sẽ bị xoá\" → xoá mềm, kết quả không còn tính vào thống kê.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-0AS.EX02",
   "text": "Chọn lại lớp đã có trong bảng → chỉ giao cho HV mới; không có HV mới → toast \"Không có học viên mới trong lớp\".",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-0AS.EX03",
   "text": "Không có khảo sát Công khai nào để thêm → dropdown hiển thị \"Không có khảo sát\".",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-0AS.EX04",
   "text": "Khảo sát đang chọn bị xoá khỏi trang Giao → chọn card đầu tiên; không còn card → empty state.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-0AS.EX05",
   "text": "Người trả lời không có avatar → avatar mặc định.",
   "source": "qc",
   "content": "qc"
  }
 ],
