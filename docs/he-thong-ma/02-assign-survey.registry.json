{
 "cluster": "02-assign-survey",
 "title": "Giao khảo sát & Kết quả (Admin)",
 "figmaPrefix": "SB-0AS",
 "requirements": [
  {
   "id": "SB-0AS.REQ01",
   "name": "Thông báo",
   "text": "Mỗi lần người nhận chuyển sang Chưa làm (giao lần đầu / giao lại) → gửi thông báo: GV = popup trên web, HV = thông báo app.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-0AS.REQ02",
   "name": "Nhãn trạng thái",
   "text": "Đang chờ / Đã giao / Thu hồi chỉ để admin theo dõi, không tự giao / thu hồi ai.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-0AS.REQ03",
   "name": "Giữ kết quả",
   "text": "Bài Đã hoàn thành luôn được tính vào kết quả, kể cả khi nhãn khảo sát là Thu hồi hoặc dòng bị thu hồi.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-0AS.REQ04",
   "name": "Cập nhật số liệu",
   "text": "Số được giao, N học viên, tỉ lệ làm cập nhật ngay sau mọi thao tác giao / thu hồi / xoá.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-0AS.REQ05",
   "name": "Disable menu",
   "text": "Item trong menu 3 chấm không hợp lệ với trạng thái hiện tại → disable.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-0AS.REQ06",
   "name": "Dữ liệu kết quả mới",
   "text": "Gọi lại API mỗi lần mở tab / popup kết quả, không dùng cache cũ.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-0AS.REQ07",
   "name": "Ký hiệu đáp án",
   "text": "A, B, C… theo thứ tự đáp án, đồng nhất với màn làm khảo sát.",
   "source": "qc",
   "content": "qc"
  }
 ],
