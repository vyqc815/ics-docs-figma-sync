{
 "cluster": "class-list-requirements",
 "title": "[Giáo viên] Lớp — Thống kê tổng quan",
 "figmaPrefix": "TR-CL",
 "requirements": [
  {
   "id": "TR-CL.REQ01",
   "name": "Phạm vi và bộ lọc",
   "text": "Lớp giáo viên được thêm vào tại trung tâm đang chọn. Tìm theo mã lớp/tên khoá; Loại lớp (`Lớp 1-1`, `Lớp chung`, `Lớp demo`), Trạng thái (7 trạng thái, mặc định `Đang học`), Trình độ; chọn nhiều, trong cùng bộ lọc là OR. Hàng thẻ và Danh sách lớp dùng cùng tập lớp thỏa bộ lọc. Không có kỳ thống kê.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "TR-CL.REQ02",
   "name": "Hàng thẻ",
   "text": "`Số lớp` = lớp Đang học / tổng lớp tập; `Đi học`, `BTVN` = trung bình tỷ lệ của mọi học viên trong tập; `Lên kỳ` = trung bình `(Đi học + BTVN)/2` của mọi học viên; `Đạt KPI` = trung bình KPI lớp (KPI lớp = trung bình Lên kỳ của học viên trong lớp), mỗi lớp trọng số bằng nhau; badge hạng theo nguồn. Làm tròn kết quả cuối 1 chữ số thập phân; học viên/lớp thiếu mẫu số không tham gia; tập rỗng `0%`.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "TR-CL.REQ03",
   "name": "Khối lớp đang chọn",
   "text": "Mặc định lớp đầu tiên; `Kết quả`, ngày bắt đầu/kết thúc, khung giờ học, 6 chỉ số theo công thức Tổng quan lớp; ẩn khi không có lớp.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "TR-CL.REQ04",
   "name": "Danh sách lớp",
   "text": "Card có icon trạng thái, mã lớp, tên khoá, tiến độ `x/y Buổi` (buổi Hoàn thành / tổng buổi khoá), badge hạng, vòng KPI lớp, `>` vào Chi tiết lớp; sắp theo mã lớp; không phân trang.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "TR-CL.REQ05",
   "name": "Đồng bộ",
   "text": "Số liệu lấy từ cùng nguồn với Tổng quan lớp và Danh sách giáo viên của Admin; đổi trung tâm thì bộ lọc về mặc định và tải lại.",
   "source": "qc",
   "content": "qc"
  }
 ],
