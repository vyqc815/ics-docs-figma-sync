{
 "cluster": "bug",
 "title": "Báo lỗi & Góp ý",
 "figmaPrefix": "SB-BU",
 "requirements": [
  {
   "id": "SB-BU.REQ01",
   "name": "Gắn ngữ cảnh ở tab Bug",
   "text": "User không cần chọn khoá học, bài học; bug tự lưu khoá học, bài học hiện tại và trung tâm đang chọn, kể cả khi Đối tượng = Khác.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-BU.REQ02",
   "name": "Sau khi gửi ở tab Bug",
   "text": "Toast \"Gửi báo lỗi thành công\", reset form về mặc định (Loại = Bug, các trường khác trống).",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-BU.REQ03",
   "name": "Nút Bug đã báo",
   "text": "Mở tab trình duyệt mới (`target=\"_blank\"`) tới trang Báo lỗi & góp ý, lọc sẵn trung tâm CD / GV đang chọn.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-BU.REQ04",
   "name": "Thẻ thống kê",
   "text": "`X/Y` = Hoàn thành / tổng, theo bộ lọc hiện tại. Tổng báo lỗi = Loại Bug (không gồm Góp ý); Lỗi nghiêm trọng = Loại Bug và mức Nghiêm trọng; Góp ý = Loại Góp ý. Cập nhật sau mỗi lần tạo, sửa, đổi trạng thái, xoá.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-BU.REQ05",
   "name": "Xem kết quả",
   "text": "Link chỉ hiển thị với bug Hoàn thành; mở popup tóm tắt chỉ đọc.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-BU.REQ06",
   "name": "Mở lại bug đã Hoàn thành",
   "text": "Chuyển từ Hoàn thành sang trạng thái khác: Kết quả xử lý giữ nguyên, không còn bắt buộc; chuyển lại Hoàn thành thì bắt buộc trở lại.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-BU.REQ07",
   "name": "Menu 3 chấm",
   "text": "Cuối mỗi dòng; gồm Chỉnh sửa, Xoá; chỉ hiển thị mục user có quyền, không có quyền nào thì ẩn nút.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-BU.REQ08",
   "name": "Xoá mềm",
   "text": "Có popup xác nhận; chỉ đánh dấu xoá. Bug đã xoá không hiển thị và không được tính ở danh sách, thống kê, popup nhắc PTL.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-BU.REQ09",
   "name": "Popup nhắc PTL",
   "text": "Hiện khi mở / reload trang lần đầu trong ngày; nội dung gồm số lượng bug chưa xử lý (Chưa đọc + Đang xử lý) và danh sách các bug đó. Ghi nhận đã nhắc theo user + ngày ở BE ngay khi hiển thị (reload hoặc đổi thiết bị trong cùng ngày không hiện lại).",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-BU.REQ10",
   "name": "Trung tâm khi gửi từ danh sách",
   "text": "PTL bắt buộc chọn Trung tâm. GV, CD tự fill trung tâm đang chọn; danh sách trung tâm của GV chỉ gồm trung tâm được cấp quyền. Bug thuộc trung tâm đã chọn trên popup.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-BU.REQ11",
   "name": "Đổi trung tâm",
   "text": "GV, CD đổi trung tâm ở header → tải lại danh sách và thống kê theo trung tâm mới.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-BU.REQ12",
   "name": "Chống gửi trùng",
   "text": "Disable nút Gửi / Lưu / Xác nhận trong lúc chờ API phản hồi.",
   "source": "qc",
   "content": "qc"
  }
 ],
