 "exceptions": [
  {
   "id": "SB-BU.EX01",
   "text": "Thiếu trường bắt buộc (Loại, Đối tượng, Tên bug, Mô tả bug, Trung tâm, Khoá học / Bài học khi Đối tượng = PPT / PDF / BTVN) → FE báo lỗi tại field, không gọi API.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-BU.EX02",
   "text": "Loại = Bug nhưng không có tệp đính kèm (khi tạo, hoặc khi sửa mà xoá hết file) → chặn gửi/lưu, báo \"Vui lòng đính kèm ít nhất 1 tệp\". Loại = Góp ý → cho gửi không cần tệp.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-BU.EX03",
   "text": "Chọn nhiều file, trong đó có file > 25MB → chỉ loại bỏ file vượt dung lượng kèm thông báo; các file hợp lệ vẫn được nhận.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-BU.EX04",
   "text": "Mô tả bug / Kết quả xử lý vượt 500 ký tự → chặn nhập thêm.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-BU.EX05",
   "text": "Chuyển Trạng thái = Hoàn thành khi Kết quả xử lý trống → không cho Xác nhận / Lưu, báo lỗi tại field.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-BU.EX06",
   "text": "Đổi Đối tượng sang Khác → Khoá học, Bài học chuyển sang không bắt buộc, giữ giá trị đã chọn; đổi lại PPT / PDF / BTVN → bắt buộc lại. Đổi Khoá học → reset Bài học.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-BU.EX07",
   "text": "User không có quyền gọi API → BE trả 403, FE báo \"Bạn không có quyền thực hiện thao tác này\". Gồm các trường hợp:",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-BU.EX08",
   "text": "Bug đã bị người khác xoá trong lúc đang mở / đổi trạng thái → báo \"Báo lỗi không còn tồn tại\", đóng popup, tải lại danh sách.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-BU.EX09",
   "text": "Gửi / lưu thất bại (mất mạng, lỗi BE) → giữ nguyên dữ liệu đã nhập, hiển thị thông báo lỗi; với dropdown trạng thái thì trả về trạng thái cũ.",
   "source": "qc",
   "content": "qc"
  }
 ],
