{
 "cluster": "meeting-schedule",
 "title": "[Phụ trách lớp, Admin] Lịch Họp",
 "figmaPrefix": "MS-MS",
 "requirements": [
  {
   "id": "MS-MS.REQ01",
   "name": "Badge sidebar",
   "text": "Đếm cuộc họp user là người tạo hoặc người tham gia, trạng thái Mới tạo + Đang chờ + Đang tham gia; không theo bộ lọc; ẩn khi 0, `99+` khi > 99.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "MS-MS.REQ02",
   "name": "Phạm vi & quyền",
   "text": "Admin xem tất cả cuộc họp; Phụ trách lớp chỉ thấy cuộc họp mình tạo hoặc tham gia. Người tạo: sửa, đổi trạng thái, xoá. Người khác: chỉ xem. Quyền sửa/xoá kiểm tra theo `created_by`, không theo role.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "MS-MS.REQ03",
   "name": "Bộ lọc",
   "text": "Người tham gia (mặc định chính mình, danh sách mọi role ICS), Trạng thái (4 giá trị), Thời gian (14 giá trị, chọn 1); OR trong bộ lọc, AND giữa bộ lọc.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "MS-MS.REQ04",
   "name": "Dạng danh sách",
   "text": "Cột Ngày họp, Giờ họp, Chủ đề, Ghi chú, Người tham gia (4 avatar + `+N`, tooltip tên), Trạng thái (dropdown cho người tạo), icon bút; sắp xếp mới nhất trước; 10 dòng/trang.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "MS-MS.REQ05",
   "name": "Dạng lịch tuần",
   "text": "Điều hướng tuần, nút Hôm nay, highlight hôm nay, card theo giờ bắt đầu, `+N cuộc họp` khi trùng ô; không áp bộ lọc Thời gian. Ghi nhớ dạng hiển thị theo user.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "MS-MS.REQ06",
   "name": "Popup",
   "text": "Dùng chung Thêm/Chi tiết; field Chủ đề, Thời gian, Trạng thái, Người tham gia, Ghi chú, Link cuộc họp; nhãn Đã trôi qua/Sắp diễn ra; Xoá có xác nhận, xoá mềm.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "MS-MS.REQ07",
   "name": "Toast",
   "text": "`Thành Công`: `Đã thêm cuộc họp.`, `Đã cập nhật cuộc họp.`, `Đã cập nhật trạng thái.`, `Đã xoá cuộc họp.`; `Cảnh Báo` khi validate lỗi; `Có Lỗi Xảy Ra` khi lỗi. Một thao tác một Toast.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "MS-MS.REQ08",
   "name": "Log",
   "text": "Lưu người/thời điểm tạo, sửa, đổi trạng thái, xoá.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "MS-MS.REQ09",
   "name": "Người tham gia",
   "text": "Chọn được tài khoản mọi role của ICS (Admin, Phụ trách lớp, Support, Sale, Giáo viên, Trợ giảng, Học viên), chỉ tài khoản đang hoạt động.",
   "source": "qc",
   "content": "qc"
  }
 ],
