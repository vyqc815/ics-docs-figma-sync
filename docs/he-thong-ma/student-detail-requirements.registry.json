{
 "cluster": "student-detail-requirements",
 "title": "Chi tiết học viên",
 "figmaPrefix": "M-SD",
 "requirements": [
  {
   "id": "M-SD.REQ01",
   "name": "",
   "text": "Chi tiết học viên phải tải và hiển thị đúng học viên được chọn, gồm `Ảnh đại diện`, `Họ và tên`, `Ngày sinh`, `Giới tính`, `Mã người dùng`, `Số điện thoại`, `Email`, `Ghi chú`; trạng thái Chính thức được giữ trong dữ liệu, không có control ở UI mới.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-SD.REQ02",
   "name": "",
   "text": "Chỉ `Ảnh đại diện`, `Họ và tên`, `Ngày sinh`, `Giới tính`, `Số điện thoại`, `Ghi chú` được phép cập nhật. Họ và tên, Ngày sinh, Giới tính và Số điện thoại là các field bắt buộc.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-SD.REQ03",
   "name": "",
   "text": "`Mã người dùng` chính là Code được sinh theo Level tại case tạo học viên. `Mã người dùng`, `Email` và `Trạng thái` phải chỉ đọc trên UI và được bảo vệ ở backend; không được thay đổi bằng request trực tiếp.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-SD.REQ04",
   "name": "",
   "text": "Trạng thái tài khoản chỉ có giá trị `Chính thức` và không có thao tác thay đổi; UI mới không render control Trạng thái.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-SD.REQ05",
   "name": "",
   "text": "Ghi chú là field không bắt buộc; cho phép thêm, sửa, xóa trắng và không áp dụng giới hạn nội dung hoặc độ dài ở tầng nghiệp vụ.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-SD.REQ06",
   "name": "",
   "text": "Ảnh đại diện có dung lượng tối đa `25 MB`; ảnh đúng `25 MB` được chấp nhận, ảnh lớn hơn `25 MB` bị từ chối. Khi chọn ảnh hợp lệ, hệ thống hiển thị bản xem trước. Ảnh mới chỉ được lưu cùng thao tác `Cập nhật tài khoản`; không chọn ảnh mới thì giữ ảnh hiện tại, chưa có ảnh thì hiển thị avatar mặc định.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-SD.REQ07",
   "name": "",
   "text": "Cập nhật chi tiết phải có tính nguyên tử. Thành công lưu toàn bộ field hợp lệ và hiển thị notification thành công; thất bại không lưu thay đổi dở dang, giữ dữ liệu trên form và hiển thị notification lỗi trong Flow 1.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-SD.REQ08",
   "name": "",
   "text": "`Lấy lại tài khoản` bắt buộc mở popup xác nhận trước khi gửi yêu cầu. Chỉ khi user bấm `Xác nhận`, hệ thống mới đặt mật khẩu của đúng học viên thành chính xác `abc12345`; thao tác không làm thay đổi field thông tin cá nhân và phải trả về notification thành công hoặc thất bại theo Flow 2.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-SD.REQ09",
   "name": "",
   "text": "Quyền xem, cập nhật chi tiết và lấy lại mật khẩu phải tuân theo cùng phạm vi dữ liệu học viên của role hiện tại; không được truy cập hoặc thao tác trực tiếp với học viên ngoài phạm vi.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-SD.REQ10",
   "name": "",
   "text": "Khung gồm sáu tab đúng thứ tự UI, mặc định Thông tin cá nhân; tab dùng chung student_id, dữ liệu tải/rỗng/lỗi tách biệt. Quay lại danh sách giữ điều kiện trước đó.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-SD.REQ11",
   "name": "",
   "text": "Danh sách lớp giống Lịch sử lớp: cùng sáu thẻ/công thức, trạng thái lớp, tiến độ cả lớp và vòng getUpTerm. Thống kê toàn học viên; bảng phân trang từng trang; mũi tên mở Chi tiết lớp theo quyền.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-SD.REQ12",
   "name": "",
   "text": "Học phí giống tab Học phí của lịch sử, cùng hai thẻ/toàn bộ nghiệp vụ Hóa đơn hiện có, không tạo hóa đơn mới. Phân trang theo hóa đơn, không theo phân bổ; footer đơn vị hóa đơn. Thẻ lấy toàn dữ liệu, xóa đồng bộ mọi học viên liên kết.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-SD.REQ13",
   "name": "",
   "text": "Log giống Menu Nhật ký → Tab Nhật ký lớp, đổi phạm vi sang học viên. Search Tiêu đề Enter/2 giây; Đối tượng theo tác giả/nguồn, Thời gian mặc định Hôm nay. Admin/Class Handler/Support xem trong phạm vi; chỉ Class Handler/Support tạo và sửa/xóa log mình tạo; Hệ thống chỉ đọc. Load more; các phần chưa chốt tại nguồn vẫn cần xác nhận.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-SD.REQ14",
   "name": "",
   "text": "Quy trình học viên dùng Action Board và popup chọn như lớp, chỉ loại Học viên, nguồn Công khai cùng center. Admin/user được gán được Thêm/cập nhật Result; Vô hiệu chỉ xem Result cũ. Không gắn trùng, không tự hoàn thành hoặc sửa nguồn. Result theo student_id, không lẫn lớp/học viên khác. Danh sách dùng load more.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-SD.REQ15",
   "name": "",
   "text": "Ghi chú giống lịch sử, cùng note_id/student_id, mặc định Mới + Tuần này; Loại/Độ ưu tiên chưa chọn, metadata từ bình luận gần nhất. Quyền owner, văn bản thuần form thêm và bình luận văn bản thuần theo lịch sử. Load more card, đổi filter tải lại từ đầu.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-SD.REQ16",
   "name": "",
   "text": "Phân trang lớp/hóa đơn thay tập dòng; load more note/quy trình/log nối dữ liệu không trùng ID, giữ dữ liệu cũ khi lỗi và dừng khi hết. Đổi học viên/điều kiện reset page/cursor, bỏ response cũ. Thống kê/tổng tiến độ không chỉ tính phần đã tải.",
   "source": "qc",
   "content": "qc"
  }
 ],
