 "exceptions": [
  {
   "id": "M-SD.EX01",
   "text": "Không tìm thấy học viên hoặc user không có quyền trên học viên được yêu cầu → không hiển thị dữ liệu chi tiết và không cho phép cập nhật hoặc lấy lại mật khẩu.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-SD.EX02",
   "text": "Họ và tên, Ngày sinh, Giới tính hoặc Số điện thoại bị để trống; Họ và tên chỉ chứa khoảng trắng → chặn cập nhật, giữ dữ liệu trên form và hiển thị lỗi tại field tương ứng.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-SD.EX03",
   "text": "Request cập nhật có thay đổi `Mã người dùng`, `Email` hoặc `Trạng thái` → backend từ chối toàn bộ request; giữ nguyên mọi dữ liệu của học viên.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-SD.EX04",
   "text": "Ảnh đại diện vượt quá `25 MB` hoặc không đáp ứng định dạng upload của hệ thống → chặn toàn bộ thao tác cập nhật, không tải ảnh lên, giữ ảnh hiện tại và hiển thị lỗi upload. Riêng trường hợp vượt dung lượng, hiển thị `Ảnh đại diện không được vượt quá 25 MB.`",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-SD.EX05",
   "text": "Cập nhật chi tiết thất bại → không lưu bất kỳ field nào, giữ dữ liệu user đã nhập trên form và hiển thị `Không thể cập nhật thông tin học viên. Vui lòng thử lại.`",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-SD.EX06",
   "text": "Lấy lại mật khẩu thất bại → không thay đổi mật khẩu hiện tại và hiển thị `Không thể đặt lại mật khẩu học viên. Vui lòng thử lại.`",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-SD.EX07",
   "text": "User bấm `Hủy` hoặc đóng popup xác nhận lấy lại mật khẩu → không gửi yêu cầu đặt lại và giữ nguyên mật khẩu hiện tại.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-SD.EX08",
   "text": "Tải trang/lượt tiếp lỗi hoặc response cũ về muộn → không mất dữ liệu đang có hoặc trộn học viên/điều kiện; cho thử lại.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-SD.EX09",
   "text": "Quy trình sai loại/center, nguồn không Công khai, item trùng hoặc user không được phép → chặn thêm/cập nhật, không lưu một phần.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-SD.EX10",
   "text": "Học phí/ghi chú/Log kế thừa ngoại lệ và bảo vệ quyền của requirement nguồn; truy cập tab không mở rộng quyền CRUD.",
   "source": "qc",
   "content": "qc"
  }
 ],
