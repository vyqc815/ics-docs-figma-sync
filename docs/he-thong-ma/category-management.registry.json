 "exceptions": [
  {
   "id": "CM-CM2.EX01",
   "text": "Tên danh mục mới bị bỏ trống hoặc chỉ chứa khoảng trắng → chặn tạo mới, dữ liệu không thay đổi, disable nút \"+\". Nếu Enter thì hiện thông báo \"Tên danh mục không được bỏ trống\".",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-CM2.EX02",
   "text": "Khi sửa lúc `Nháp`, ID sai định dạng (không đúng 2 chữ số) hoặc trùng (kể cả trùng ID của danh mục đã xóa mềm) → hệ thống từ chối lưu, hiển thị lỗi tương ứng, giữ nguyên ID cũ.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-CM2.EX03",
   "text": "Gọi API hoặc thao tác trực tiếp đổi trạng thái không hợp lệ (từ `Công Khai`/`Vô hiệu` về `Nháp`, hoặc từ `Nháp` sang thẳng `Vô hiệu`) → hệ thống từ chối, hiển thị thông báo lỗi (ví dụ: `\"Không thể chuyển sang trạng thái này.\"`), giữ nguyên trạng thái hiện tại. UI chỉ hiển thị lựa chọn hợp lệ: `Nháp` chỉ có `Công Khai`; `Công Khai` chỉ có `Vô hiệu`; `Vô hiệu` chỉ có `Công Khai`.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-CM2.EX04",
   "text": "Cố sửa ID khi danh mục có trạng thái khác `Nháp` → hệ thống từ chối, field ID ở trạng thái chỉ đọc/disable.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-CM2.EX05",
   "text": "ID hợp lệ tại thời điểm nhập nhưng bị đối tượng khác dùng ngay trước lúc backend lưu (race condition) → backend từ chối tại bước kiểm tra cuối, không lưu, giữ nguyên trạng thái và hiển thị lỗi.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-CM2.EX06",
   "text": "Trong popup Kích hoạt công khai danh mục, ID nhập tay hoặc ID vừa được làm mới sai định dạng (không đúng 2 chữ số) hoặc đã bị trùng → hiển thị lỗi tương ứng ngay trong popup, vô hiệu hóa nút `Công khai danh mục`, giữ danh mục ở `Nháp`.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-CM2.EX07",
   "text": "CD bấm `Hủy` hoặc đóng popup Kích hoạt công khai danh mục sau khi đã sửa ID trong ô nhập → không lưu ID vừa sửa, ID của danh mục giữ nguyên như trước khi mở popup, trạng thái vẫn là `Nháp`.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-CM2.EX08",
   "text": "Xóa danh mục `Công Khai` / `Vô hiệu` (gọi API trực tiếp) → backend từ chối, trả lỗi `Chỉ xóa được danh mục ở trạng thái Nháp.`. Xóa danh mục `Nháp` đang có khóa học (qua UI, gọi API trực tiếp, hoặc khóa học được tạo ngay trước lúc backend xóa) → backend từ chối, trả lỗi `Danh mục đang được sử dụng, không thể xóa.`. FE hiển thị Toast lỗi với nội dung backend trả về, dữ liệu không đổi.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-CM2.EX09",
   "text": "Người dùng không có quyền gửi request xóa trực tiếp → từ chối, không thay đổi dữ liệu.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-CM2.EX10",
   "text": "Sửa Tên danh mục thành trống hoặc chỉ chứa khoảng trắng (ở bất kỳ trạng thái nào) → từ chối lưu, báo lỗi tại field Tên, giữ nguyên Tên cũ.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-CM2.EX11",
