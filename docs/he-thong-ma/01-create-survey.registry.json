  {
   "id": "SB-0CS.REQ01",
   "name": "Trim dữ liệu",
   "text": "Trim tên, mô tả, nội dung câu hỏi, đáp án. Chỉ có khoảng trắng = trống.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-0CS.REQ02",
   "name": "Dòng đáp án trống",
   "text": "Không lưu, không hiển thị ở Xem trước.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-0CS.REQ03",
   "name": "Ký hiệu đáp án",
   "text": "Admin nhập text thuần. A, B, C… do hệ thống tự gắn theo thứ tự khi hiển thị cho người làm và ở kết quả.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-0CS.REQ04",
   "name": "Empty state",
   "text": "Tab chưa có khảo sát / chưa chọn khảo sát → panel giữa hiển thị hướng dẫn tạo khảo sát ở danh sách bên phải.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-0CS.REQ05",
   "name": "Thang đánh giá",
   "text": "Cố định 1–5 sao.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-0CS.REQ06",
   "name": "Khảo sát đã giao",
   "text": "Khảo sát đã thêm vào trang Giao vẫn giữ nguyên (người nhận làm và xem kết quả bình thường) khi khảo sát chuyển Vô hiệu hoặc bị xoá ở trang Tạo.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "SB-0CS.REQ07",
   "name": "Dùng chung component",
   "text": "Phần hiển thị câu hỏi ở Xem trước dùng chung với màn Làm khảo sát ([03-take-survey.md](./03-take-survey.md)) và popup Kết quả từng giáo viên ([02-assign-survey.md](./02-assign-survey.md)).",
   "source": "qc",
   "content": "qc"
  }
