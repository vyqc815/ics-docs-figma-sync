{
 "cluster": "class-detail-processes-requirements",
 "title": "Chi tiết lớp học — Tiêu chuẩn lớp - giáo viên, CSKH và Quy trình lớp",
 "figmaPrefix": "M-CDP",
 "requirements": [
  {
   "id": "M-CDP.REQ01",
   "name": "Nguồn",
   "text": "Ba loại quy trình được định nghĩa riêng ngoài lớp. Nguồn ICS dùng chung bảng ComGao và theo center. Popup chỉ hiển thị Package từ quy trình Công khai cùng center: tab Tiêu chuẩn lớp - giáo viên lấy Lớp - Giáo viên, CSKH lấy CSKH (Support), Quy trình lớp lấy Lớp học.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDP.REQ02",
   "name": "Quyền",
   "text": "Phải được add vào lớp mới được vào Chi tiết lớp và xem tab theo quyền. Chỉ Class Handler/Support của lớp được Thêm và cập nhật Result; không phụ thuộc người đã thêm item. Ngoại lệ: Giáo viên của lớp tick Action `Xác thực` có mình trong Người gán (tab Tiêu chuẩn lớp - giáo viên).",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDP.REQ03",
   "name": "Result",
   "text": "Lưu riêng theo lớp, loại quy trình và Action Item; tiến độ theo Action Board. Định nghĩa đã Công khai bị khóa thêm/sửa/xóa nên không có tình huống đổi Loại task hoặc xóa item nguồn sau khi gắn vào lớp. Khi nguồn Công khai, cập nhật Result theo quyền lớp. Khi nguồn Vô hiệu, vẫn hiện nội dung/Result cũ nhưng chỉ xem; Công khai lại thì áp dụng quyền cập nhật theo role lớp.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDP.REQ04",
   "name": "Chọn nội dung",
   "text": "Chọn nhiều cấp; Hủy không lưu; không thêm trùng hoặc tự ghi Result; chỉ lưu nguồn còn Công khai.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDP.REQ05",
   "name": "Phản hồi",
   "text": "Lưu thành công/lỗi có một Toast đúng kết quả; Hủy và chỉ xem không có Toast CRUD.",
   "source": "qc",
   "content": "qc"
  }
 ],
