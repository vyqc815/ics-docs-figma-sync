{
 "cluster": "detail-category",
 "title": "Chi tiết danh mục (Popup)",
 "figmaPrefix": "CM-DC",
 "requirements": [
  {
   "id": "CM-DC.REQ01",
   "name": "ID khóa học",
   "text": "9 chữ số `CCAALLMMM`, quy tắc sinh, đồng bộ và khoá theo `course_management.md` REQ06. Khi ID danh mục (đang `Nháp`) đổi, `AA` trong ID mọi khóa học `Nháp` thuộc danh mục đổi theo và hệ thống cấp lại `MMM` nếu trùng trong `CCAALL` mới (khóa học `Công Khai` / `Vô hiệu` không thể thuộc danh mục `Nháp`).",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-DC.REQ02",
   "name": "Rule chuyển trạng thái khóa học",
   "text": "theo `course_management.md` REQ05: `Nháp → Công Khai` (một chiều, qua popup); `Công Khai ↔ Vô hiệu` (hai chiều); không cho `Nháp → Vô hiệu` và không cho chuyển về `Nháp`. UI chỉ hiển thị lựa chọn hợp lệ; request trực tiếp với transition không hợp lệ bị backend từ chối.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-DC.REQ03",
   "name": "Thông tin cơ bản khóa học",
   "text": "Tên bắt buộc, không giới hạn độ dài. Mô tả và Cấp độ không bắt buộc (mặc định `Không` nếu chưa chọn Cấp độ); được phép giữ Cấp độ `Không` kể cả khi khóa học đã `Công Khai`, không bắt buộc phải chọn cấp độ cụ thể. Số kỳ tự tính, không nhập tay. Mỗi khóa học thuộc đúng 1 danh mục (`1:n`); được thêm mới bất kể danh mục đang ở trạng thái nào.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-DC.REQ04",
   "name": "Cấu hình nội dung danh mục",
   "text": "Chỉ sửa được khi danh mục `Nháp`; `Công Khai` / `Vô hiệu` chỉ đọc (EX12). Tại mỗi tab Mindset/Tiêu chuẩn giáo trình/Hướng dẫn giảng dạy, chọn nhiều package/category rồi nhiều action item trực thuộc, không giới hạn số lượng. Dữ liệu nguồn chỉ được tham chiếu, không sao chép hay chỉnh sửa; thay đổi tại feature định nghĩa được phản ánh vào nội dung áp dụng.",
   "source": "qc",
   "content": "qc"
  }
 ],
