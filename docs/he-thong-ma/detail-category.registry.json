 "exceptions": [
  {
   "id": "CM-DC.EX01",
   "text": "Tên khóa học mới bị bỏ trống hoặc chỉ chứa khoảng trắng → chặn tạo mới, disable nút \"+\", khi Enter hiện lỗi \"Tên khoá học không được bỏ trống\".",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-DC.EX02",
   "text": "Trong popup Kích hoạt công khai khoá học, `MMM` sai định dạng hoặc ID 9 số trùng → từ chối, hiển thị lỗi, giữ nguyên ID cũ (course_management.md EX05).",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-DC.EX03",
   "text": "Cấp độ đã chọn chuyển sang `Vô hiệu hóa`/không còn khả dụng trước khi lưu → không lưu cấp độ không hợp lệ; dữ liệu đã lưu trước đó không đổi. (Cấp độ đang được khóa học sử dụng không thể bị xóa, chỉ có thể bị Vô hiệu hóa — xem `level_management.md` REQ07.)",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-DC.EX04",
   "text": "Gọi API/thao tác trực tiếp chuyển trạng thái từ `Công Khai`/`Vô hiệu` về `Nháp` → hệ thống từ chối, báo lỗi, giữ nguyên trạng thái; UI không hiển thị lựa chọn `Nháp`.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-DC.EX05",
   "text": "Cố sửa ID khi khóa học đã rời khỏi `Nháp` → từ chối, field ID chỉ đọc/disable.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-DC.EX06",
   "text": "ID hợp lệ tại thời điểm nhập nhưng bị đối tượng khác dùng ngay trước lúc backend lưu (race condition) → backend từ chối, giữ nguyên trạng thái, báo lỗi.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-DC.EX07",
   "text": "Tìm kiếm khóa học không có kết quả → hiển thị \"Không có dữ liệu\", không đổi dữ liệu.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-DC.EX08",
   "text": "Package/category hoặc action item bị xóa/không còn khả dụng tại feature định nghĩa → nội dung tham chiếu tại danh mục phản ánh trạng thái mới, không hiển thị như còn hiệu lực.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-DC.EX09",
   "text": "Lưu/áp dụng cấu hình thất bại → không hiển thị \"Áp dụng thành công!\", không lưu một phần.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-DC.EX10",
   "text": "Người dùng không có quyền, truy cập/gửi request trực tiếp → từ chối, không đổi dữ liệu.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-DC.EX11",
   "text": "Quyền `Chỉ xem` gửi request tick chọn/lưu trực tiếp → hệ thống từ chối, giữ nguyên cấu hình danh mục.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-DC.EX12",
   "text": "Tick chọn / lưu cấu hình khi danh mục `Công Khai` / `Vô hiệu` (UI hoặc request trực tiếp) → UI chỉ đọc; backend từ chối, trả lỗi `Danh mục không ở trạng thái Nháp, chỉ được sửa Tên và Mô tả.`, cấu hình không đổi.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-DC.EX13",
   "text": "Sửa field ngoài Tên, Mô tả của khóa học `Công Khai` / `Vô hiệu`, hoặc xóa khóa học không ở `Nháp` tại tab Tổng quan → backend từ chối theo `course_management.md` EX09, EX11.",
   "source": "qc",
   "content": "qc"
  }
 ],
