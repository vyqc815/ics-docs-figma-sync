 "exceptions": [
  {
   "id": "T-MV.EX01",
   "text": "Chưa xác thực tài khoản Google khi thao tác (chưa liên kết hoặc hết phiên) → hiển thị \"Bạn chưa xác thực tài khoản google\" (`txtNotLoggedIn`), yêu cầu xác minh lại.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "T-MV.EX02",
   "text": "Reload trang → mất liên kết Google, quay lại bước đăng nhập Google.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "T-MV.EX03",
   "text": "Move dòng không xanh mà BE kiểm tra vẫn không hợp lệ → hiển thị đúng lỗi tương ứng (bảng 2.3) trong danh sách, file không bị đổi tên/move, dòng giữ nguyên.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "T-MV.EX04",
   "text": "File không còn trong `MEET RECORDINGS SS` khi move → hiển thị lỗi \"Không tìm thấy file video trong drive MEET RECORDINGS SS\" (`txtErrorInvalidFile`) trong danh sách.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "T-MV.EX05",
   "text": "Trùng tên file video trong `MEET RECORDINGS SS` → \"Trùng tên file video trong drive MEET RECORDINGS SS\" (`txtErrorDuplicateVideo`).",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "T-MV.EX06",
   "text": "Trùng link meet hoặc trùng video khi move → \"Trùng link meet hoặc trùng video, vui lòng kiểm tra lại\" (`txtDuplicateLinkOrVideo`) trong danh sách.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "T-MV.EX07",
   "text": "Đổi tên và di chuyển hàng loạt mà có dòng xanh move thất bại → \"Vẫn còn một số link video bị lỗi, vui lòng kiểm tra lại\" (`txtStillSomeErrorVideo`).",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "T-MV.EX08",
   "text": "User bấm Huỷ ở popup → đóng popup, không gọi API, không thay đổi gì.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "T-MV.EX09",
   "text": "Tên rỗng ở popup → nút Xác nhận không cho bấm.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "T-MV.EX10",
   "text": "Huỷ ở popup xác nhận xoá → không xoá, các dòng vẫn giữ trạng thái tick.",
   "source": "qc",
   "content": "qc"
  }
 ],
