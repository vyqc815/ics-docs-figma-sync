{
 "cluster": "move-video",
 "title": "Move Video",
 "figmaPrefix": "T-MV",
 "requirements": [
  {
   "id": "T-MV.REQ01",
   "name": "Nguồn danh sách",
   "text": "Danh sách = các file record trong folder tổng `MEET RECORDINGS SS` trên Drive của tài khoản Gmail đã xác minh, chưa bị xoá mềm.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "T-MV.REQ02",
   "name": "Quy tắc xác định buổi học",
   "text": "Link cuộc họp → DB → class → id → course_id → các lesson cùng course_id mới nhất được mở → tên buổi học.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "T-MV.REQ03",
   "name": "Điều kiện lớp",
   "text": "Chỉ class có status **In progress** mới được sử dụng.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "T-MV.REQ04",
   "name": "Folder và tên file đích",
   "text": "Class code = tên folder trong drive `SCREEN RECORDING`. Tên file đích mặc định `ngày_tên lesson` do hệ thống đặt khi move; user có thể sửa ở popup.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "T-MV.REQ05",
   "name": "Phân loại trạng thái",
   "text": "Mỗi dòng được gán trạng thái theo bảng bên dưới; quyết định màu badge, icon và thông báo. Chỉ dùng các thông báo trong bảng này.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "T-MV.REQ06",
   "name": "Hiển thị lỗi",
   "text": "Mọi lỗi hiển thị ngay trong danh sách (cột Bài học), không dùng popup lỗi.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "T-MV.REQ07",
   "name": "Filter",
   "text": "Lọc theo **ngày tạo file trên Drive**, cho chọn 1 ngày hoặc khoảng ngày, đặt cạnh nút Xác minh lại, mặc định là tất cả.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "T-MV.REQ08",
   "name": "Popup Đổi tên video",
   "text": "Dùng cho cả dòng xanh và không xanh; tên rỗng không cho Xác nhận.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "T-MV.REQ09",
   "name": "Đổi tên hai nơi",
   "text": "Cả icon bút và nút Move đều mở popup Đổi tên video. Icon bút: đổi tên file ở folder tổng. Move: đổi tên file ở folder của lớp rồi move.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "T-MV.REQ10",
   "name": "Copy tên video",
   "text": "Icon copy bên trái tên video copy tên video.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "T-MV.REQ11",
   "name": "Đổi tên và di chuyển hàng loạt",
   "text": "Chỉ áp dụng cho các dòng xanh; không xử lý dòng cam/đỏ. Bấm là move luôn, không popup.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "T-MV.REQ12",
   "name": "Xoá mềm",
   "text": "Bấm Xoá hiện popup xác nhận. Dòng đã xoá không hiển thị trong danh sách nữa. Trên Drive, tên file được thêm hậu tố `_deleted_{account người xoá}` (ví dụ `..._deleted_dacnham`).",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "T-MV.REQ13",
   "name": "Sau khi move thành công",
   "text": "File không còn trong folder tổng nên dòng biến mất khỏi danh sách.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "T-MV.REQ14",
   "name": "Xác minh lại",
   "text": "Nút `Xác minh lại` lấy lại danh sách file mới nhất từ Drive.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "T-MV.REQ15",
   "name": "Màu badge khi nhiều lỗi",
   "text": "Mặc định cam; nếu có lỗi loại đỏ thì badge đỏ. Các lỗi đều hiển thị trong cột Bài học.",
   "source": "qc",
   "content": "qc"
  }
 ],
