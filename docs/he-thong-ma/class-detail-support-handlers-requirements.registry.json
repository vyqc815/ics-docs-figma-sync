{
 "cluster": "class-detail-support-handlers-requirements",
 "title": "Chi tiết lớp học — Tab Trợ giảng & Phụ trách lớp",
 "figmaPrefix": "M-CDS4",
 "requirements": [
  {
   "id": "M-CDS4.REQ01",
   "name": "Thuật ngữ và hiển thị",
   "text": "Tab là `Trợ giảng & Phụ trách lớp`; Trợ giảng ánh xạ role Support, Phụ trách lớp ánh xạ role Class Handler. Mỗi danh sách chỉ có Tên, Email, Xóa; không có Phụ trách chính.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDS4.REQ02",
   "name": "Chọn Phụ trách lớp có sẵn",
   "text": "Bấm `+` mở lựa chọn `Chọn phụ trách lớp` hoặc `Tạo phụ trách lớp mới`. Với flow chọn có sẵn, Admin/Class Handler tìm theo tên/email, multi-select các Class Handler đang hoạt động và chưa thuộc lớp; thêm nguyên tử.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDS4.REQ03",
   "name": "Chọn Trợ giảng có sẵn",
   "text": "Bấm `+` mở lựa chọn `Chọn trợ giảng` hoặc `Tạo trợ giảng mới`. Với flow chọn có sẵn, Admin/Class Handler tìm theo tên/email, multi-select các Support đang hoạt động và chưa thuộc lớp; không có role Assistant Teacher riêng.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDS4.REQ04",
   "name": "Tạo mới và tự thêm",
   "text": "Dùng form tạo tài khoản dùng chung. Flow Phụ trách lớp khóa role `Class Handler`; flow Trợ giảng khóa role `Support`. Tạo xong tự thêm vào đúng lớp/khu vực; không cấp quyền chấm điểm; chống tạo trùng khi retry lỗi liên kết.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDS4.REQ05",
   "name": "Xóa quan hệ",
   "text": "Bấm X gửi request ngay, không popup xác nhận; chỉ xóa quan hệ với lớp, không xóa tài khoản/lịch sử; idempotent.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDS4.REQ06",
   "name": "Quyền hỗ trợ, không chấm điểm",
   "text": "Class Handler và Support được xem/hỗ trợ quản lý theo permission từng function nhưng không được nhập/cập nhật điểm BTVN hoặc bài kiểm tra. Chỉ Giáo viên phụ trách chính có quyền chấm.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDS4.REQ07",
   "name": "Audit và an toàn",
   "text": "Lưu người/thời điểm cho thao tác chọn có sẵn, tạo mới, tự thêm và xóa; không tin role/phạm vi do client gửi; text hiển thị an toàn và lỗi không lộ thông tin kỹ thuật/dữ liệu nhạy cảm.",
   "source": "qc",
   "content": "qc"
  }
 ],
