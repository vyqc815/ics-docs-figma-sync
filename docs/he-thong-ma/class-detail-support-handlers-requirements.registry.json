 "exceptions": [
  {
   "id": "M-CDS4.EX01",
   "text": "Popup Phụ trách lớp nhận user không phải Class Handler, đã thuộc lớp, bị khóa hoặc ngoài phạm vi → từ chối toàn bộ multi-select.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDS4.EX02",
   "text": "Popup Trợ giảng nhận user không phải Support, đã thuộc lớp, bị khóa hoặc ngoài phạm vi → từ chối toàn bộ multi-select.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDS4.EX03",
   "text": "Flow tạo mới nhận dữ liệu trùng/sai validation, role bị sửa hoặc người dùng mất quyền → không tạo tài khoản và quan hệ một phần; trả lỗi đúng field/nguyên nhân.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDS4.EX04",
   "text": "Tạo tài khoản thành công nhưng gắn lớp thất bại → không hiển thị quan hệ giả; retry bằng ID/idempotency key cũ, không tạo tài khoản trùng.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDS4.EX05",
   "text": "Xóa thất bại, request lặp hoặc quan hệ đã đổi → xử lý idempotent, không xóa nhầm tài khoản/người khác và đồng bộ lại UI.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDS4.EX06",
   "text": "Class Handler hoặc Support gửi request chấm điểm BTVN/bài kiểm tra → backend từ chối, kể cả người đó đang được phân công vào lớp.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "M-CDS4.EX07",
   "text": "Role không phải Admin/Class Handler gửi request chọn có sẵn, tạo mới hoặc xóa nhân sự tại tab → backend từ chối; Support chỉ xem.",
   "source": "qc",
   "content": "qc"
  }
 ],
