{
 "cluster": "class-information-requirements",
 "title": "[Giáo viên] Chi tiết lớp — Thông tin",
 "figmaPrefix": "TR-CI",
 "requirements": [
  {
   "id": "TR-CI.REQ01",
   "name": "Thông tin chỉ đọc",
   "text": "9 field theo nguồn Admin Tab Thông tin; không có control ghi; link Meet mở tab mới.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "TR-CI.REQ02",
   "name": "KPI của tôi",
   "text": "Chỉ khoản loại KPI của giáo viên đang đăng nhập tại lớp đang mở; trạng thái Mới / Đã xác nhận / Đã hủy, ẩn Đã xóa; cột Tên, Ngày ghi nhận, Trạng thái, Số tiền, Ngày cập nhật; tên lấy từ `title` của cấu hình KPI được khoản tham chiếu, mô tả từ `description` nếu có; tìm theo tên; sắp Ngày ghi nhận giảm dần; chỉ đọc.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "TR-CI.REQ03",
   "name": "Phạm vi và bộ lọc lương",
   "text": "Dữ liệu của giáo viên đang đăng nhập tại lớp đang mở. 10 lựa chọn thời gian, mặc định Tháng này; buổi lọc theo ngày tính lương (ngày của lịch gắn; không lịch thì thời điểm hoàn thành), KPI lọc theo Ngày ghi nhận.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "TR-CI.REQ04",
   "name": "Công thức",
   "text": "Số buổi đã dạy = buổi Hoàn thành của giáo viên trong khoảng (kể cả không lịch). Lương buổi dạy = tổng lương các buổi Hoàn thành có lịch gắn (lương/buổi của giáo viên tại lớp); buổi không lịch = 0 kèm cảnh báo. Lương KPI = tổng KPI Đã xác nhận trong khoảng. Tổng lương = Lương buổi dạy + Lương KPI. Sĩ số buổi = đi học / học viên hợp lệ.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "TR-CI.REQ05",
   "name": "Đồng bộ",
   "text": "Cùng nguồn với menu Lịch sử & lương của Giáo viên và Tab KPI/Lịch dạy của Admin; hoàn thành buổi, xác nhận KPI, Mở lại lịch (đảo lương) phải phản ánh khi tải lại.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "TR-CI.REQ06",
   "name": "Giữ lương buổi đã hoàn thành",
   "text": "Lưu mức lương của buổi khi hoàn thành. Thay đổi lương/buổi chỉ áp dụng cho các buổi hoàn thành sau thời điểm thay đổi; không tính lại dòng cũ hoặc tổng lương lịch sử theo mức mới. Bộ lọc vẫn dùng ngày tính lương đã chốt, độc lập với thời điểm ghi nhận mức lương.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "TR-CI.REQ07",
   "name": "Phạm vi OT",
   "text": "Không có OT ở tab Lịch sử & lương trong Thông tin lớp; Tổng Lương tại đây chỉ gồm lương buổi dạy và KPI. OT được xem ở menu Lịch sử & lương riêng của Giáo viên.",
   "source": "qc",
   "content": "qc"
  }
 ],
