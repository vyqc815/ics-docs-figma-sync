{
 "cluster": "teacher-role-teaching-schedule-teaching-schedule-requirements",
 "title": "[Giáo viên] Lịch dạy",
 "figmaPrefix": "TR-TS",
 "requirements": [
  {
   "id": "TR-TS.REQ01",
   "name": "Phạm vi lịch dạy",
   "text": "Chỉ lịch có giáo viên được phân công là người đang đăng nhập; không lấy toàn bộ lịch của lớp chỉ vì người đó tham gia lớp. Backend kiểm tra phạm vi.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "TR-TS.REQ02",
   "name": "Tuần",
   "text": "Mặc định tuần hiện tại, Thứ 2–Chủ Nhật, mũi tên dịch một tuần; header và thẻ cùng khoảng theo timezone nghiệp vụ.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "TR-TS.REQ03",
   "name": "Cách trình bày",
   "text": "Theo lớp hoặc theo ngày, cùng tập lịch; mỗi lịch một thẻ, sắp tăng theo giờ trong ngày; đủ chỗ xem mọi lịch.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "TR-TS.REQ04",
   "name": "Màu và nghiệp vụ",
   "text": "Lịch Hủy bỏ vẫn hiển thị màu xám, ưu tiên hơn màu thời gian và không phát sinh lương. Lịch không hủy dùng màu theo ngày. Màu thời gian không tự thay trạng thái hoặc ghi nhận lương; không đánh đồng lịch đã qua với buổi đã hoàn thành.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "TR-TS.REQ05",
   "name": "Lịch dạy chỉ đọc",
   "text": "Thẻ chỉ hiển thị, không có hành động khi bấm, không mở popup và không điều hướng. Không CRUD/hủy/hoàn thành/mở lại trực tiếp tại tab này. Giáo viên hoàn thành qua luồng Bài học được cấp quyền theo requirement riêng.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "TR-TS.REQ06",
   "name": "Lịch đăng ký",
   "text": "Lưới 3 buổi × 7 thứ của chính giáo viên; một ô một khung giờ và ghi chú riêng; một ô là một ca, tối đa 21. Ghi chú chung độc lập. Không tạo buổi dạy/lương từ lịch đăng ký.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "TR-TS.REQ07",
   "name": "Popup",
   "text": "Giờ bắt đầu/kết thúc bắt buộc, đúng khung buổi và mốc 30 phút, kết thúc sau bắt đầu; xác nhận chỉ cập nhật nháp, hủy không đổi ô. Backend validate lại khi lưu.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "TR-TS.REQ08",
   "name": "Fulltime",
   "text": "Bật chọn thêm ô trống với giờ trọn buổi, không đổi giờ/ghi chú ô cũ. Tick khi đủ 21 ô; gỡ một ô tự bỏ tick. Chủ động bỏ Fulltime sẽ bỏ chọn toàn bộ ô đang chọn trong nháp; chỉ bấm Cập nhật mới ghi backend. Fulltime tự bỏ tick do gỡ một ô riêng không kích hoạt gỡ toàn bộ.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "TR-TS.REQ09",
   "name": "Nháp và lưu",
   "text": "Chỉ Cập nhật mới ghi toàn bộ lịch đăng ký chính thức; không lưu từng ô. Chặn gửi lặp, lưu toàn bộ hoặc không lưu; lỗi giữ nháp, rời màn cảnh báo khi chưa lưu.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "TR-TS.REQ10",
   "name": "Đồng bộ và xung đột",
   "text": "Dùng cùng nguồn với màn quản lý; chỉ response mới nhất cập nhật UI; phát hiện sửa đồng thời thay vì âm thầm ghi đè. Bỏ khung giờ rảnh vẫn cho lưu bình thường dù có lịch dạy đã phân công trong khung đó; không cảnh báo/chặn vì lý do này và không tự sửa/hủy/xóa lịch dạy đã xếp.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "TR-TS.REQ11",
   "name": "Quyền và audit",
   "text": "Giáo viên chỉ xem/cập nhật đăng ký của mình; server kiểm tra phiên đăng nhập, trạng thái tài khoản và phạm vi. Cập nhật bởi giáo viên ghi đúng owner/actor; quản lý cập nhật thay theo requirement Chi tiết giáo viên.",
   "source": "qc",
   "content": "qc"
  }
 ],
