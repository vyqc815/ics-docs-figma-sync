 "exceptions": [
  {
   "id": "TR-TS.EX01",
   "text": "Truy cập lịch người khác, thay owner/actor hoặc cập nhật lịch dạy trái quyền → backend từ chối; không tiết lộ/cập nhật dữ liệu ngoài phạm vi.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "TR-TS.EX02",
   "text": "Tuần không có lịch dạy → lưới trống; chưa đăng ký ca nào → lưới đăng ký trống. Không coi trạng thái chưa có dữ liệu là lỗi; khả năng lưu một lịch đăng ký rỗng cần xác nhận.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "TR-TS.EX03",
   "text": "Tải lịch hoặc đăng ký thất bại → lỗi có Thử lại, không dùng dữ liệu mẫu hoặc dữ liệu người/tuần khác thay thế.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "TR-TS.EX04",
   "text": "Thiếu giờ, ngoài khung buổi, sai mốc 30 phút hoặc kết thúc không lớn hơn bắt đầu → không nhận nháp ô/lưu backend, chỉ rõ lỗi để sửa.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "TR-TS.EX05",
   "text": "Lưu thất bại hoặc bấm lặp → không lưu một phần, giữ nháp; chặn gửi lặp trong khi đang xử lý.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "TR-TS.EX06",
   "text": "Phiên bản lịch đăng ký đã thay đổi → báo xung đột, không âm thầm ghi đè.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "TR-TS.EX07",
   "text": "Rời màn khi có nháp chưa lưu → cảnh báo; ở lại giữ nháp, bỏ thay đổi thì không tự lưu.",
   "source": "qc",
   "content": "qc"
  }
 ],
