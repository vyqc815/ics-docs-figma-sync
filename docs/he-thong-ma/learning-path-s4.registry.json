{
 "cluster": "learning-path-s4",
 "title": "Lộ Trình (S4)",
 "figmaPrefix": "CM-LPS2",
 "requirements": [
  {
   "id": "CM-LPS2.REQ01",
   "name": "Nguồn dữ liệu",
   "text": "Cột buổi học, số buổi, phút/buổi từng cột, phút chuẩn 1 buổi lấy từ S2; thứ tự cột theo S2.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-LPS2.REQ02",
   "name": "Tính toán realtime",
   "text": "Header cột, badge và cột Thời gian (giá trị + màu) tính lại ngay sau mỗi thao tác, không reload.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-LPS2.REQ03",
   "name": "Công thức",
   "text": "Thời gian hàng = Σ phút/buổi của các cột đã tick trong hàng (`HH:mm:ss`). % màu = Thời gian hàng / phút chuẩn 1 buổi (S2).",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-LPS2.REQ04",
   "name": "Badge cột",
   "text": "Theo số tick so với tổng buổi: `Chưa đủ buổi` (cam) / `Đủ buổi` (xanh) / `Quá buổi` (đỏ). `00/00` hiển thị `Đủ buổi`.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-LPS2.REQ05",
   "name": "Màu cột Thời gian",
   "text": "90–100% xanh, 80–<90% vàng, >0 và <80% cam, 0 xám, >100% đỏ (giống tab Bài học của Học kỳ). Chỉ cảnh báo bằng màu, không chặn.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-LPS2.REQ06",
   "name": "Freeze",
   "text": "Cố định 4 cột đầu và hàng header; cột buổi học không đè lên cột cố định khi cuộn ngang.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-LPS2.REQ07",
   "name": "Header cột buổi học",
   "text": "Dòng 1 `SỐ BUỔI {đã tick}/{tổng số buổi}`; dòng 2 `[ {tổng phút đã xếp} PHÚT ]` = số tick × phút/buổi của cột, bắt đầu từ `0` và cộng/trừ theo từng lần tick/bỏ tick.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-LPS2.REQ08",
   "name": "Kéo thả",
   "text": "Thứ tự bài học được lưu, STT cập nhật theo; chỉ dùng cho màn này.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-LPS2.REQ09",
   "name": "Dropdown Kỳ",
   "text": "Danh sách kỳ của khoá học hiện tại; mặc định kỳ của bài học; hiển thị mã kỳ + tên kỳ. Đổi Kỳ sẽ chuyển bài học sang học kỳ mới (đồng bộ tab Bài học của Học kỳ).",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-LPS2.REQ10",
   "name": "Sửa inline",
   "text": "Tên (bắt buộc) và mô tả (không bắt buộc) bài học sửa trực tiếp tại ô; dữ liệu dùng chung với tab Bài học của Học kỳ.",
   "source": "qc",
   "content": "qc"
  }
 ],
