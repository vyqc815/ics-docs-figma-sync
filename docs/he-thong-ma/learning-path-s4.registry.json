 "exceptions": [
  {
   "id": "CM-LPS2.EX01",
   "text": "Số tick của cột > tổng buổi → vẫn cho tick, badge `Quá buổi` (đỏ), không popup chặn.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-LPS2.EX02",
   "text": "Bỏ tick/đổi S2 làm số tick về = tổng buổi → badge `Đủ buổi`; < tổng buổi → `Chưa đủ buổi`. Trường hợp tổng buổi = 0 và chưa tick (`00/00`) → `Đủ buổi`.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-LPS2.EX03",
   "text": "Hàng chưa tick ô nào → Thời gian `00:00:00`, màu xám.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-LPS2.EX04",
   "text": "S2 đổi số buổi / phút mỗi buổi / phút chuẩn 1 buổi → giữ nguyên tick; tính lại header cột (tổng phút đã xếp = số tick × phút/buổi mới), badge, Thời gian và màu từng hàng theo giá trị mới.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-LPS2.EX05",
   "text": "S2 xoá buổi học → xoá toàn bộ tick của cột đó, tính lại Thời gian các hàng liên quan.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-LPS2.EX06",
   "text": "S2 thêm buổi học → hiển thị thêm cột mới chưa tick (`00/{tổng}`, `[ 0 PHÚT ]`, badge `Chưa đủ buổi`).",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-LPS2.EX07",
