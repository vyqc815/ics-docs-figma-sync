 "exceptions": [
  {
   "id": "AM-AM.EX01",
   "text": "Tạo tài khoản không chọn role nào → chặn submit, báo lỗi \"Vui lòng chọn ít nhất 1 role\".",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "AM-AM.EX02",
   "text": "Tạo tài khoản với email đã tồn tại → báo lỗi \"Email đã được sử dụng\".",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "AM-AM.EX03",
   "text": "Đặt lại mật khẩu cho tài khoản đang có phiên đăng nhập → hủy session ở **tất cả thiết bị**, tài khoản phải đăng nhập lại.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "AM-AM.EX04",
   "text": "Vô hiệu hóa (tắt kích hoạt) tài khoản đang có phiên đăng nhập → **buộc đăng xuất ngay lập tức trên tất cả thiết bị** (hủy toàn bộ session, giống hành vi đặt lại mật khẩu), đồng thời chặn đăng nhập ở các lần sau.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "AM-AM.EX05",
   "text": "Master cố **xóa hoặc tắt kích hoạt chính tài khoản Master đang đăng nhập** → hệ thống **chặn hành động**, báo lỗi (tránh tự khóa mình khỏi hệ thống).",
   "source": "qc",
   "content": "qc"
  }
 ],
