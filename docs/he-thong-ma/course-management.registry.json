 "exceptions": [
  {
   "id": "CM-CM.EX01",
   "text": "Tên khoá học mới bị bỏ trống hoặc chỉ chứa khoảng trắng → Chặn tạo mới, dữ liệu không thay đổi, disable nút \"+\"/Enter, không có notification hiển thị.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-CM.EX02",
   "text": "Lọc/tìm kiếm với điều kiện không khớp khoá học nào → Trả về danh sách rỗng, hiển thị \"Không có dữ liệu\".",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-CM.EX03",
   "text": "Gọi API cập nhật trạng thái hoặc xoá mềm thất bại (lỗi mạng/server) → Giữ nguyên trạng thái/dữ liệu hiện tại trên UI, hiển thị thông báo lỗi, không cập nhật is_deleted/status.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-CM.EX04",
   "text": "Gọi API đổi trạng thái với transition không hợp lệ (Nháp → Vô hiệu, Công Khai → Nháp, Vô hiệu → Nháp) → BE từ chối, trả lỗi, FE giữ nguyên trạng thái hiện tại, hiển thị thông báo lỗi.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-CM.EX05",
   "text": "Trong popup Công khai, `MMM` không đúng định dạng 3 chữ số `001`–`999` (thiếu số, thừa số, chứa ký tự không phải số, `000`) hoặc ID 9 số trùng với ID khoá học khác (kể cả khoá học đã xoá mềm) → hiển thị lỗi \"ID không hợp lệ. Vui lòng kiểm tra.\" dưới ô ID, chặn nút \"Công khai khoá học\", trạng thái giữ nguyên.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-CM.EX06",
   "text": "Trong popup Công khai, bỏ trống Danh mục và/hoặc Cấp độ và/hoặc Mô tả → hiển thị lỗi bắt buộc dưới từng trường tương ứng, chặn nút \"Công khai khoá học\", trạng thái giữ nguyên.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-CM.EX07",
   "text": "CD nhấn \"Hủy\" hoặc đóng popup (icon \"X\") ở bất kỳ bước nào trước khi xác nhận thành công → đóng popup, không lưu thay đổi, trạng thái khoá học giữ nguyên như trước khi mở popup.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-CM.EX08",
   "text": "Gọi API xác nhận Công khai thất bại (lỗi mạng/server) → giữ nguyên trạng thái Nháp, popup vẫn mở (hoặc hiển thị lại), hiển thị thông báo lỗi, dữ liệu ID/Danh mục/Cấp độ/Mô tả chưa lưu.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-CM.EX09",
   "text": "Xoá khoá học không ở `Nháp` (`Công Khai` / `Vô hiệu`, gọi API trực tiếp) hoặc khoá học `Nháp` đang được sử dụng (gán cho lớp, có học kỳ nằm trong Tổng ôn của khoá khác), kể cả khi tham chiếu vừa phát sinh ngay trước lúc BE xoá → BE từ chối, trả lỗi (ví dụ `Chỉ xoá được khoá học ở trạng thái Nháp.` hoặc `Khoá học đang được sử dụng, không thể xoá.`); FE đóng popup xác nhận, hiển thị Toast lỗi với đúng nội dung BE trả về, dữ liệu giữ nguyên.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-CM.EX10",
   "text": "Nhân bản khoá học thất bại (lỗi mạng/server, lỗi ở bất kỳ bước sao chép nào) → BE rollback toàn bộ, không tạo khoá học/học kỳ/bài học bản sao dở dang; FE hiển thị Toast lỗi `Có Lỗi Xảy Ra` với nội dung BE trả về, khoá gốc không đổi.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-CM.EX11",
   "text": "Sửa field ngoài `Tên khoá học` / `Mô tả`, hoặc thêm / sửa / xoá / sắp xếp bất kỳ dữ liệu chi tiết bên trong (học kỳ, bài học, bài kiểm tra, BTVN, bộ câu hỏi, S1, S2, S4, Quản lý, Tài liệu) khi khoá học đang `Công Khai` / `Vô hiệu` (qua UI hoặc gọi API trực tiếp) → UI ở dạng chỉ đọc (ẩn/disable thao tác); BE từ chối, trả lỗi `Khoá học không ở trạng thái Nháp, chỉ được sửa Tên và Mô tả.`, dữ liệu không đổi.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-CM.EX12",
   "text": "Chọn Danh mục / Cấp độ (ở danh sách, popup Công khai hoặc khi nhân bản) mà `CCAALL` tương ứng đã dùng hết `MMM` `001`–`999` → BE từ chối, trả lỗi `Đã hết ID khoá học khả dụng cho Danh mục và Cấp độ này.`; FE hiển thị Toast lỗi (ở popup: lỗi dưới ô ID, tắt nút `Công khai khoá học`), Danh mục / Cấp độ / ID giữ như trước; nhân bản thì không tạo bản sao (giống EX10).",
   "source": "qc",
   "content": "qc"
  }
 ],
