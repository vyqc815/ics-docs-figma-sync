{
 "cluster": "course-management",
 "title": "Quản lý khoá học",
 "figmaPrefix": "CM-CM",
 "requirements": [
  {
   "id": "CM-CM.REQ01",
   "name": "",
   "text": "Xoá khoá học là xoá mềm, không xoá dữ liệu vật lý; các kỳ học con cũng được xoá mềm, cần có popup xác nhận trước khi xoá. **Chỉ khoá học `Nháp` được xoá**; khoá học `Công Khai` / `Vô hiệu` không được xoá (muốn ngừng dùng thì để/chuyển `Vô hiệu`). Khoá học `Nháp` đang được sử dụng cũng không được xoá (REQ08). Nút Xoá mờ + tooltip với khoá `Công Khai` / `Vô hiệu`; BE luôn kiểm tra lại trạng thái và tham chiếu tại thời điểm xoá, FE hiển thị Toast lỗi với nội dung BE trả về (EX09). Quy tắc **\"chỉ `Nháp` được xoá; `Công Khai`, `Vô hiệu` không được xoá\"** áp dụng chung cho mọi dữ liệu có trạng thái Nháp / Công Khai / Vô hiệu trong Khoá học, Học kỳ, Danh mục, Cấp độ.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-CM.REQ02",
   "name": "",
   "text": "Danh mục và Cấp độ chỉ nhận giá trị từ danh sách đã define sẵn ở màn hình cấu hình riêng, không cho nhập tự do (áp dụng cả ở màn hình danh sách lẫn trong popup Công khai); Số kỳ tự động tính từ số lượng kỳ học con, không cho nhập/sửa tay.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-CM.REQ03",
   "name": "",
   "text": "Danh sách khoá học không phân trang, hiển thị toàn bộ khoá học chưa bị xoá mềm.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-CM.REQ04",
   "name": "",
   "text": "Khoá học đã Xoá (xoá mềm) không hiển thị trong danh sách và không lọc/tìm kiếm ra được.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-CM.REQ05",
   "name": "",
   "text": "Ràng buộc chuyển trạng thái khoá học (3 trạng thái: **Nháp**, **Công Khai**, **Vô hiệu**):",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-CM.REQ06",
   "name": "ID khoá học",
   "text": "đúng **9 chữ số** `CCAALLMMM`, chỉ gồm chữ số (giữ số 0 đứng đầu):",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-CM.REQ07",
   "name": "",
   "text": "Khi chuyển trạng thái khoá học từ Nháp sang Công Khai, hệ thống **bắt buộc** hiển thị popup \"Kích hoạt công khai khoá học\" yêu cầu điền/xác nhận đầy đủ 4 trường: ID (9 số `CCAALLMMM`, CD chỉ sửa `MMM`), Danh mục, Cấp độ, Mô tả. Popup này luôn hiển thị và yêu cầu xác nhận lại toàn bộ 4 trường **ngay cả khi** các trường đó đã được điền sẵn từ trước ở màn hình danh sách (inline) — không được bỏ qua popup hay tự động công khai chỉ vì dữ liệu inline đã đầy đủ. Trạng thái chỉ đổi thành Công Khai sau khi CD xác nhận thành công trong popup. Chiều Vô hiệu → Công Khai chuyển ngay, không mở popup.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-CM.REQ08",
   "name": "",
   "text": "Ràng buộc xoá khoá học: ngoài điều kiện phải đang `Nháp` (REQ01), khoá học **đang được sử dụng** (có lớp học gắn với khoá học, hoặc có học kỳ của khoá nằm trong Tổng ôn của học kỳ thuộc khoá khác — chỉ tính bản ghi chưa xoá mềm) thì **không được xoá**. BE kiểm tra trạng thái, tham chiếu và xoá mềm trong cùng một giao dịch, từ chối nếu không hợp lệ; FE hiển thị Toast lỗi với nội dung BE trả về (EX09). Khoá học `Vô hiệu` không hiển thị để chọn mới ở nơi khác (vd. tạo lớp), dữ liệu đang dùng giữ nguyên.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-CM.REQ09",
   "name": "",
   "text": "Tìm kiếm khoá học khớp một phần theo ID hoặc Tên khoá học, kích hoạt sau khi nhấn Enter. Tên khoá học chưa giới hạn độ dài.",
   "source": "qc",
   "content": "qc"
  },
  {
   "id": "CM-CM.REQ11",
   "name": "Nhân bản khoá học (deep clone)",
   "text": "Nhân bản được ở mọi trạng thái khoá gốc; bản sao luôn `Nháp`, khoá gốc giữ nguyên. Toàn bộ thao tác thực hiện trong **một giao dịch** (thành công hết hoặc không tạo gì, EX10). Phạm vi:",
   "source": "qc",
   "content": "qc"
  }
 ],
