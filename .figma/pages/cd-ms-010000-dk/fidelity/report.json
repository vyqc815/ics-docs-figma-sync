    },
    {
      "id": "4056:144641",
      "name": "Kiến thức bài trước phải được tái sử dụng ở những bài sau, không đưa kiến thức nâng cao xuất hiện sớm hơn lộ trình, tránh thiết kế bài học rời rạc.",
      "pixels": 2250,
      "percent": 7.3
    },
    {
      "id": "4056:144623",
      "name": "Kiến thức từ giáo trình phải được học viên ứng dụng theo mục đích cụ thể (ví dụ học hội thoại về mua sắm phải ứng dụng thực tế được khi học viên đi mua sắm...).",
      "pixels": 2026,
      "percent": 6.6
    },
    {
      "id": "4056:144632",
