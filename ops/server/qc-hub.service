# /etc/systemd/system/qc-hub.service — QC Hub (Next.js standalone) trên server công ty.
# Bản đang chạy: /opt/qc-hub/current (link tới releases/<commit>, do workflow Deploy demo, job "server" đặt).
[Unit]
Description=QC Hub (ics-figma-demo)
After=network.target

[Service]
User=qchub
WorkingDirectory=/opt/qc-hub/current
EnvironmentFile=/opt/qc-hub/.env
Environment=NODE_ENV=production HOSTNAME=127.0.0.1 PORT=3200
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
