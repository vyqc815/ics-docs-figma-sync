# /opt/qc-hub/.env (chmod 600, chủ sở hữu qchub). Sửa xong: sudo systemctl restart qc-hub
QC_WEB_PASSWORD=          # mật khẩu team = đăng nhập admin, cũng là khoá ký cookie
FIGMA_ACCESS_TOKEN=       # ảnh Figma trực tiếp, quét dự án
GITHUB_WRITE_TOKEN=       # sửa requirement, tài khoản, mốc đồng bộ (Contents + Actions RW trên repo này)
GITHUB_REPO=vyqc815/ics-docs-figma-sync
DOCS_FIGMA_URL=https://icstestsapi.pls.edu.vn/docs-figma
