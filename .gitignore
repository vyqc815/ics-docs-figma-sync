node_modules
.next
out
.env*.local
*.tsbuildinfo
next-env.d.ts
.DS_Store

# figma-page demo: never commit local env files
.env

# figma-page: page specs and exported assets are regenerated from Figma;
# keep only what the fidelity check of pages with code needs.
.figma/pages/*/page-spec.json
.figma/pages/*/assets/
.figma/pages/snapshot.json
!.figma/pages/thu-vien-kien-thuc/page-spec.json

# figma-page check: screenshots and diffs are rebuilt on every check.
.figma/pages/*/fidelity/*.png

# Python bytecode
__pycache__/
.vercel
.env*

# figma-ref: copied from .figma/pages/*/reference@1x.png at build (scripts/figma/copy-refs.mjs)
public/figma-ref/

# figma-page pipeline (tools/figma-console-mcp): build output and its own dependencies
tools/*/node_modules/
tools/*/dist/
